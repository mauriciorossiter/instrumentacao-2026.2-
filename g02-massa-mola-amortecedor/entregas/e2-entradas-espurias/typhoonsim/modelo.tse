        component "core/C function" CalCorrection1 {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            init_fnc = "/*Begin code section*/

/*End code section*/"
            input_terminals = "real in;inherit sin;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True"
            input_terminals_show_labels = "True;True"
            output_fnc = "/*Begin code section*/
double FS   = 500.0;
double VEXC = 10.0;
double SENS = 3.0;
double TCAL = 20.0;
double ZTC  = 0.000015;
double STC  = 0.000011;

double VFS = VEXC * SENS / 1000.0;
double dT  = sin - TCAL;                   // usa a temperatura medida

double y = in - ZTC * dT * VFS;            // 1) remove erro de zero
y = y / (1.0 + STC * dT);                  // 2) remove erro de span

out = y;                                   // saida corrigida, em volts
/*End code section*/"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "False"
            update_fnc = "/*Begin code section*/

