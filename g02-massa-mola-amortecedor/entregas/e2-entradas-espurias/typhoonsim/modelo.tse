            output_fnc = "/*Begin code section*/
double TMED = 29.5;
double AMP  = 8.5;
double FREQ = 1.0;
double DT = 100e-6;
double PI = 3.14159265358979;

T = TMED + AMP * sin(2.0 * PI * FREQ * t_acc);
t_acc = t_acc + DT;
/*End code section*/"
            output_terminals = "real T;"
