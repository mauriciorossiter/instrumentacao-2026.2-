                init_fnc = "/*Begin code section*/

/*End code section*/"
                input_terminals = "real x;real xm;"
                input_terminals_dimensions = "(1,);(1,)"
                input_terminals_feedthrough = "True;True"
                input_terminals_show_labels = "True;True"
                output_fnc = "/*Begin code section*/
double FS   = 500.0;      // fundo de escala, kg
double VEXC = 10.0;       // excitacao, V
double SENS = 3.0;        // sensibilidade, mV/V (datasheet Rev16)
double TCAL = 20.0;       // temperatura de calibracao, degC
double ZTC  = 0.000015;   // 0.015 %FS/10C -> fracao por C  (0.015/100/10)
double STC  = 0.000011;   // 0.011 %FS/10C -> fracao por C

double VFS   = VEXC * SENS / 1000.0;      // saida de fundo de escala = 0.030 V
double y_id  = (x / FS) * VFS;            // saida ideal (calibrada a TCAL)
double dT    = xm - TCAL;                  // desvio de temperatura

double e_span = STC * dT * y_id;          // erro de span (modificante)

y = y_id + e_span;               // saida contaminada
/*End code section*/"
                output_terminals = "real y;"
                output_terminals_dimensions = "inherit"
                output_terminals_feedthrough = "True"
                output_terminals_show_labels = "False"
                update_fnc = "/*Begin code section*/

/*End code section*/"
            }
