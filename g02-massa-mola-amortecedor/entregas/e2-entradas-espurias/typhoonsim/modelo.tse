double FS   = 500.0;      // fundo de escala, kg
double VEXC = 10.0;       // excitacao, V
double SENS = 3.0;        // sensibilidade, mV/V (datasheet Rev16)
double TCAL = 20.0;       // temperatura de calibracao, degC
double ZTC  = 0.000015;   // 0.015 %FS/10C -> fracao por C  (0.015/100/10)
