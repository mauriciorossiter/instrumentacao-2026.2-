            size = 720, 360
            background_color = #0e2a78d6
        ]

        connect ensaio.out gerador_ensaios.ensaio as Connection1
        connect amplitude.out gerador_ensaios.amplitude as Connection2
        connect disparo.out gerador_ensaios.disparo as Connection3
        connect J_r gerador_ensaios.r as Connection4
        connect J_r r.in as Connection5
        connect J_r Vf_atuador.in as Connection6
        connect gerador_ensaios.t_ens t_ensaio.in as Connection7
        connect Vf_atuador.p_node L_massa.p_node as Connection8
        connect L_massa.n_node v_massa.p_node as Connection9
        connect v_massa.n_node R_amortecedor.p_node as Connection10
        connect J_p4 R_amortecedor.n_node as Connection11
        connect J_p4 C_mola.p_node as Connection12
        connect J_p4 y_real.p_node as Connection13
        connect J_p0 C_mola.n_node as Connection14
        connect J_p0 y_real.n_node as Connection15
        connect J_p0 Vf_atuador.n_node as Connection16
        connect J_p0 gnd_planta.node as Connection17
        connect y_real.out x_real.in as Connection18
    }

