        component "core/C function" ruido_branco {
            arb_defs = "/*Begin code section*/
/* Ruido branco gaussiano: xorshift32 (semente fixa) + Box-Muller, retido a cada 1e-4 s. */
unsigned int x_N = 610839777u;
double g_N = 0.0;
double u1_N = 0.5;
double u2_N = 0.5;
double PI_N = 3.14159265358979323846;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
x_N = 610839777u;
x_N ^= x_N << 13; x_N ^= x_N >> 17; x_N ^= x_N << 5;
u1_N = ((x_N >> 8) + 0.5) / 16777216.0;
x_N ^= x_N << 13; x_N ^= x_N >> 17; x_N ^= x_N << 5;
u2_N = ((x_N >> 8) + 0.5) / 16777216.0;
g_N = sqrt(-2.0 * log(u1_N)) * cos(2.0 * PI_N * u2_N);
/*End code section*/"
            input_terminals = "real en_ruido;real sigma_mV;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True"
            input_terminals_show_labels = "True;True"
            output_fnc = "/*Begin code section*/
n = (en_ruido > 0.5) ? (sigma_mV * 1e-3 * g_N) : 0.0;
/*End code section*/"
            output_terminals = "real n;"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
x_N ^= x_N << 13; x_N ^= x_N >> 17; x_N ^= x_N << 5;
u1_N = ((x_N >> 8) + 0.5) / 16777216.0;
x_N ^= x_N << 13; x_N ^= x_N >> 17; x_N ^= x_N << 5;
u2_N = ((x_N >> 8) + 0.5) / 16777216.0;
g_N = sqrt(-2.0 * log(u1_N)) * cos(2.0 * PI_N * u2_N);
/*End code section*/"
        }
        [
            position = 8040, 7740
            size = 112, 72
        ]

        component "core/C function" interferencia {
            arb_defs = "/*Begin code section*/
/* Entradas espurias na entrada do pre-amplificador (10 MOhm):
 * offset 3 mV (VIO tipico do TL072), deriva 5 mV a 0,05 Hz (piroeletricidade do PZT, estimativa),
 * zumbido de 60 Hz com 20 mV de pico (entrada sem blindagem, estimativa). */
double A_OFF_I = 3e-3;
double A_DRIFT_I = 5e-3;
double F_DRIFT_I = 0.05;
double A_HUM_I = 20e-3;
double TS_I = 1e-4;
double PI_I = 3.14159265358979323846;
double t_I = 0.0;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
t_I = 0.0;
/*End code section*/"
            input_terminals = "real en_interf;"
            input_terminals_dimensions = "inherit"
            input_terminals_feedthrough = "True"
            input_terminals_show_labels = "True"
            output_fnc = "/*Begin code section*/
if (en_interf > 0.5) {
    interf = A_OFF_I + A_DRIFT_I * sin(2.0 * PI_I * F_DRIFT_I * t_I) + A_HUM_I * sin(2.0 * PI_I * 60.0 * t_I);
} else {
    interf = 0.0;
}
/*End code section*/"
            output_terminals = "real interf;"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
t_I = t_I + TS_I;
if (t_I >= 20.0) { t_I = t_I - 20.0; }
/*End code section*/"
        }
        [
            position = 8040, 8100
            size = 112, 48
        ]

        component "core/C function" condicionamento_lockin {
            arb_defs = "/*Begin code section*/
/* Condicionamento: pre-amplificador nao inversor (G = 5) + demodulacao sincrona (lock-in)
 * + Butterworth de 2a ordem com fc ajustavel, discretizado por Tustin a 10 kHz. */
double G_L = 5;
double PI_L = 3.14159265358979323846;
double TS_L = 1e-4;
double fc_ant_L = -1.0;
double B0_L = 0.0, B1_L = 0.0, B2_L = 0.0, A1_L = 0.0, A2_L = 0.0;
double z0_L = 0.0, z1_L = 0.0;
double dem_L = 0.0, y_L = 0.0;
double wb_L = 0.0, K_L = 0.0, a2_L = 0.0, a1_L = 0.0, A0_L = 0.0, fcu_L = 1.0;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
fc_ant_L = -1.0;
z0_L = 0.0;
z1_L = 0.0;
/*End code section*/"
            input_terminals = "real v_piezo;real n;real interf;real car;real fc_Hz;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True"
            output_fnc = "/*Begin code section*/
fcu_L = (fc_Hz < 0.05) ? 0.05 : fc_Hz;
if (fcu_L != fc_ant_L) {                   /* recalcula os coeficientes quando fc muda */
    wb_L = 2.0 * PI_L * fcu_L;
    K_L = 2.0 / TS_L;
    a2_L = 1.0 / (wb_L * wb_L);
    a1_L = 1.41421356237 / wb_L;
    A0_L = a2_L * K_L * K_L + a1_L * K_L + 1.0;
    B0_L = 1.0 / A0_L;
    B1_L = 2.0 / A0_L;
    B2_L = 1.0 / A0_L;
    A1_L = (2.0 - 2.0 * a2_L * K_L * K_L) / A0_L;
    A2_L = (a2_L * K_L * K_L - a1_L * K_L + 1.0) / A0_L;
    fc_ant_L = fcu_L;
}
pre_amp = G_L * (v_piezo + n + interf);
dem_L = pre_amp * car;
y_L = B0_L * dem_L + z0_L;
demod = dem_L;
bw = y_L;
/*End code section*/"
            output_terminals = "real pre_amp;real demod;real bw;"
            output_terminals_dimensions = "1;1;1"
            output_terminals_feedthrough = "True;True;True"
            output_terminals_show_labels = "True;True;True"
            update_fnc = "/*Begin code section*/
z0_L = B1_L * dem_L - A1_L * y_L + z1_L;
z1_L = B2_L * dem_L - A2_L * y_L;
/*End code section*/"
        }
