        component "core/C function" sensor_piezo {
            arb_defs = "/*Begin code section*/
/* Camada estatica do disco piezoeletrico (Murata 7BB-20-6, ceramica APC 850).
 * S nominal = d33/Ct = 400 pC/N / 10 nF = 40 mV/N.
 * Pior caso inferior (padrao): 320 pC/N / 13 nF = 24,6 mV/N (-38 %).
 * Limiar e resolucao: estimativas da equipe. */
double S_NOM_S = 0.04;     /* V/N */
double F_LIM_S = 0.02;     /* N   */
double F_RES_S = 0.01;     /* N   */
double S_use_S = 0.04;
double Fa_S = 0.0;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
S_use_S = S_NOM_S;
/*End code section*/"
            input_terminals = "real Fk;real car;real en_sens;real S_real_mVN;real en_lim;real en_res;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True"
            output_fnc = "/*Begin code section*/
F_inst = Fk * car;                                  /* forca modulada pela portadora */
S_use_S = (en_sens > 0.5) ? (S_real_mVN * 1e-3) : S_NOM_S;
Fa_S = F_inst;
if (en_lim > 0.5 && fabs(Fa_S) < F_LIM_S) { Fa_S = 0.0; }                 /* limiar    */
if (en_res > 0.5) { Fa_S = F_RES_S * floor(Fa_S / F_RES_S + 0.5); }       /* resolucao */
vctrl = S_use_S * Fa_S;                              /* fonte de Thevenin do piezo */
/*End code section*/"
            output_terminals = "real vctrl;real F_inst;"
            output_terminals_dimensions = "1;1"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
            update_fnc = "/*Begin code section*/
/* sem estados */
/*End code section*/"
        }
