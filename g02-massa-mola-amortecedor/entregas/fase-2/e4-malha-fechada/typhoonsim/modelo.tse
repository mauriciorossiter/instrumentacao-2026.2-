        component "core/C function" controlador_PID {
            arb_defs = "/*Begin code section*/
/* PID com derivada na medicao (filtro Tf), saturacao do atuador e anti-windup condicional. */
double integ_C = 0.0;
double dfilt_C = 0.0;
double dnovo_C = 0.0;
double yprev_C = 0.0;
int primeiro_C = 1;
double e_C = 0.0;
double ulin_C = 0.0;
double u_C = 0.0;
double disp_ant_C = 0.0;
double TS_C = 1e-4;     /* s */
double TF_C = 0.01;     /* s, filtro da derivada */
double UMAX_C = 60.0;   /* N, limite do atuador  */
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
integ_C = 0.0;
dfilt_C = 0.0;
primeiro_C = 1;
/*End code section*/"
            input_terminals = "real r;real y;real d;real malha;real Kp;real Ki;real Kd;real disparo;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True;True;True"
            output_fnc = "/*Begin code section*/
if (malha > 0.5) {
    e_C = r - y;
    if (primeiro_C) { yprev_C = y; }
    dnovo_C = dfilt_C + TS_C / TF_C * (-Kd * (y - yprev_C) / TS_C - dfilt_C);
    ulin_C = Kp * e_C + Ki * integ_C + dnovo_C;
    u_C = ulin_C;
    if (u_C > UMAX_C) { u_C = UMAX_C; }
    if (u_C < -UMAX_C) { u_C = -UMAX_C; }
} else {
    e_C = 0.0;
    dnovo_C = 0.0;
    ulin_C = r;
    u_C = r;                   /* malha aberta: a referencia e a propria forca */
}
u = u_C;
F = u_C + d;
/*End code section*/"
            output_terminals = "real u;real F;"
            output_terminals_dimensions = "1;1"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
            update_fnc = "/*Begin code section*/
if (disparo > 0.5 && disp_ant_C <= 0.5) {      /* novo ensaio: zera os estados do PID */
    integ_C = 0.0;
    dfilt_C = 0.0;
    primeiro_C = 1;
} else if (malha > 0.5) {
    dfilt_C = dnovo_C;
    yprev_C = y;
    primeiro_C = 0;
    if (u_C == ulin_C || (ulin_C > UMAX_C && e_C < 0.0) || (ulin_C < -UMAX_C && e_C > 0.0)) {
        integ_C = integ_C + e_C * TS_C;
    }
} else {
    integ_C = 0.0;
    dfilt_C = 0.0;
    primeiro_C = 1;
}
disp_ant_C = disparo;
/*End code section*/"
        }
