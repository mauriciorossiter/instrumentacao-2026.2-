        component "core/C function" portadora_chopper {
            arb_defs = "/*Begin code section*/
/* Portadora da chopagem (modulacao) e da demodulacao sincrona. */
double t_P = 0.0;
double TS_P = 1e-4;
double F_CH_P = 100.0;                    /* Hz */
double PI_P = 3.14159265358979323846;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
t_P = 0.0;
/*End code section*/"
            input_terminals = "real chop;"
            input_terminals_dimensions = "inherit"
            input_terminals_feedthrough = "True"
            input_terminals_show_labels = "True"
            output_fnc = "/*Begin code section*/
if (chop > 0.5) {
    car = 1.41421356237 * sin(2.0 * PI_P * F_CH_P * t_P);
} else {
    car = 1.0;                            /* sem chopagem: forca aplicada direto (DC) */
}
/*End code section*/"
            output_terminals = "real car;"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
t_P = t_P + TS_P;
if (t_P >= 1.0) { t_P = t_P - 1.0; }      /* 100 periodos inteiros por segundo */
/*End code section*/"
        }
        [
            position = 7400, 7620
            size = 112, 48
