        component "core/C function" camada_estatica {
            arb_defs = "/*Begin code section*/
/* Chaves das não idealidades: 1 = liga, 0 = desliga */
int EN_SENS = 0;          /* desvio de sensibilidade */
int EN_LIM  = 0;          /* limiar                  */
int EN_RES  = 0;          /* resolução               */

/* Sensibilidade nominal (Entrega 01): S = d33/Ct = 400 pC/N / 10 nF */
double S_NOM = 0.04;      /* V/N */

/* Sensibilidade real: extremos das tolerâncias de catálogo
 *   d33 = 400 pC/N ±20 %  (APC International, APC 850)
 *   Ct  = 10 nF   ±30 %   (Murata, 7BB-20-6, a 1 kHz)
 * Caso mínimo (padrão): 320 pC/N / 13 nF = 24,6 mV/N  (-38 %)
 * Caso máximo:          480 pC/N /  7 nF = 68,6 mV/N  (+71 %)        */
double D33_REAL = 320e-12;   /* C/N */
double CT_REAL  = 13e-9;     /* F   */

/* Limiar e resolução: ESTIMATIVAS DA EQUIPE (não tabeladas pelo fabricante) */
double F_LIM = 0.02;      /* N: |F| abaixo disto não produz saída       */
double F_RES = 0.01;      /* N: menor variação de força que muda a saída */

/* Variáveis de trabalho */
double S_use;
double F_a;
/*End code section*/"
            execution_rate = "1e-06"
            init_fnc = "/*Begin code section*/
S_use = S_NOM;
F_a = 0.0;
/*End code section*/"
            input_terminals = "real F;"
            input_terminals_dimensions = "inherit"
            input_terminals_feedthrough = "True"
            input_terminals_show_labels = "True"
            output_fnc = "/*Begin code section*/
/* 1) Sensibilidade */
if (EN_SENS) {
    S_use = D33_REAL / CT_REAL;
} else {
    S_use = S_NOM;
}

F_a = F;

/* 2) Limiar: abaixo de F_LIM a saída é nula; acima, segue a entrada */
if (EN_LIM) {
    if (fabs(F_a) < F_LIM) {
        F_a = 0.0;
    }
}

/* 3) Resolução: a força só é \"vista\" em múltiplos de F_RES */
if (EN_RES) {
    F_a = F_RES * floor(F_a / F_RES + 0.5);
}

vctrl = S_use * F_a;
/*End code section*/"
            output_terminals = "real vctrl;"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
/* (vazio: o bloco é estático, sem estados) */
/*End code section*/"
        }
