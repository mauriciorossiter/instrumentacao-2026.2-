        component "core/C function" WhiteNoise {
            arb_defs = "/*Begin code section*/
unsigned int x_rng;      /* estado do xorshift32 (32 bits)  */
double g_n;              /* amostra gaussiana N(0,1) atual  */
double u1_n;             /* uniforme 1                      */
double u2_n;             /* uniforme 2                      */
double SIGMA_N = 0.0;   /* desvio-padrão do ruído, em V    */
double PI_N = 3.14159265358979323846;
/*End code section*/"
            execution_rate = "1e-4"
            init_fnc = "/*Begin code section*/
x_rng = 610839777u;      /* semente fixa: mesmo ruído a cada execução */

x_rng ^= x_rng << 13;
x_rng ^= x_rng >> 17;
x_rng ^= x_rng << 5;
u1_n = ((x_rng >> 8) + 0.5) / 16777216.0;   /* uniforme em (0,1), nunca 0 */

x_rng ^= x_rng << 13;
x_rng ^= x_rng >> 17;
x_rng ^= x_rng << 5;
u2_n = ((x_rng >> 8) + 0.5) / 16777216.0;

g_n = sqrt(-2.0 * log(u1_n)) * cos(2.0 * PI_N * u2_n);   /* Box-Muller */
/*End code section*/"
            input_terminals = ""
            input_terminals_dimensions = ""
            input_terminals_feedthrough = ""
            input_terminals_show_labels = ""
            output_fnc = "/*Begin code section*/
n = SIGMA_N * g_n;
/*End code section*/"
            output_terminals = "real n;"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
x_rng ^= x_rng << 13;
x_rng ^= x_rng >> 17;
x_rng ^= x_rng << 5;
u1_n = ((x_rng >> 8) + 0.5) / 16777216.0;

x_rng ^= x_rng << 13;
x_rng ^= x_rng >> 17;
x_rng ^= x_rng << 5;
u2_n = ((x_rng >> 8) + 0.5) / 16777216.0;

g_n = sqrt(-2.0 * log(u1_n)) * cos(2.0 * PI_N * u2_n);
/*End code section*/"
        }
