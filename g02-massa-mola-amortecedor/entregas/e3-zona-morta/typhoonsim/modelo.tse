            output_fnc = "/*Begin code section*/
// Onda senoidal periódica
static double t = 0.0;
double Ts = 0.0001;      // passo de simulação (ajuste ao seu Ts real!)
double freq = 0.1;       // frequência em Hz (0.1 Hz = período de 10 s)
double amplitude = 10.0; // amplitude do seno
double offset = 0.0;     // deslocamento vertical (use amplitude p/ oscilar entre 0 e 2*amplitude)

double saida = offset + amplitude * sin(2.0 * M_PI * freq * t);

out = saida;
t = t + Ts;   // incrementa o tempo a cada passo
/*End code section*/"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/

