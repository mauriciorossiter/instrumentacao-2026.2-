        component "core/C function" dead_zone {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            init_fnc = "/*Begin code section*/

/*End code section*/"
            input_terminals = "real in;inherit val;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True"
            input_terminals_show_labels = "True;True"
            output_fnc = "/*Begin code section*/
static double out_ant = 0.0;   // valor anterior da saída

double Zx    = val;   // largura da zona morta
double ganho = 1.0;   // inclinação da parte ativa (fe)

double sup = ganho * in - Zx / 2.0;   // limite quando a entrada sobe
double inf = ganho * in + Zx / 2.0;   // limite quando a entrada desce

double saida = out_ant;

if (saida < sup) {
    saida = sup;   // entrada subiu o bastante → puxa a saída pra cima
}
if (saida > inf) {
    saida = inf;   // entrada desceu o bastante → puxa a saída pra baixo
}

out = saida;
out_ant = saida;
/*End code section*/"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "False"
