            input_terminals = ""
            input_terminals_dimensions = ""
            input_terminals_feedthrough = ""
            input_terminals_show_labels = ""
            output_fnc = "/*Begin code section*/
// Rampa triangular: 0 → 10 → 0 (periódica)
static double t = 0.0;
double Ts = 0.0001;      // passo de simulação (ajuste ao seu Ts real!)
double periodo = 10.0;   // 5s subindo + 5s descendo
double amplitude = 10.0;

double fase = fmod(t, periodo);
double saida;

if (fase < periodo / 2.0) {
    saida = amplitude * (fase / (periodo / 2.0));       // subida
} else {
    saida = amplitude * (1.0 - (fase - periodo / 2.0) / (periodo / 2.0));  // descida
}

out = saida;

t = t + Ts;   // incrementa o tempo a cada passo
/*End code section*/"
            output_terminals_dimensions = "1"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/

/*End code section*/"
        }
