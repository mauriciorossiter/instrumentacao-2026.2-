                <id>e9e6fda33f8349acb02d979b73e869f4</id>
                <name><![CDATA[Equilibrio]]></name>
                <type>MacroButton</type>
                <description><![CDATA[]]></description>
                <on_use_code active="True"><![CDATA[_q=float(panel.get_property_value(panel.get_widget_by_fqn("Q_rel"),"widget_value"))
for _j in (1,2):
    _g=float(panel.get_property_value(panel.get_widget_by_fqn("G"+str(_j)+"_rel"),"widget_value"))
    panel.set_property_value(panel.get_widget_by_fqn("Vref"+str(_j)),"widget_value",10*(_q/_g)**2)
]]></on_use_code>
