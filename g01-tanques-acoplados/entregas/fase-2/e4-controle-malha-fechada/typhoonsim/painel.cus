        <component_data>
                <id>5bd0c7e9dc6a4c21a91dfc8c2e409dae</id>
                <name><![CDATA[Caso]]></name>
                <type>TextNote</type>
                <description><![CDATA[]]></description>
                <text><![CDATA[subida-real]]></text>
                <widget_settings>
                    <x>20</x>
                    <y>346</y>
                    <width>225</width>
                    <height>40</height>
                    <background_color><![CDATA[None]]></background_color>
                    <background_type><![CDATA[Transparent]]></background_type>
                    <appearance><![CDATA[Flat]]></appearance>
