            output_fnc = "/*Begin code section*/
double tempo = in; // Recebe a variável tempo do bloco Clock
double A = 1.0;       // Amplitude do sinal
double w0 = 2 * 3.14159 * 60; // Frequência angular (Ex: 60Hz)
double soma = 0.0;
int N = 50;           // Número máximo de harmônicos

// Laço que calcula apenas os harmônicos ímpares
for (int n = 1; n <= N; n += 2) {
    soma += (4.0 * A / (n * 3.14159)) * sin(n * w0 * tempo);
}

out = soma; // Entrega o sinal truncado reconstruído na saída
/*End code section*/"
            output_terminals_dimensions = "inherit"
