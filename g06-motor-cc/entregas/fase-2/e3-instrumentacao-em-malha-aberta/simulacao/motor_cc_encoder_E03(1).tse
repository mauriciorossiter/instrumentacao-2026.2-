        component "core/C function" Gerador_ensaio {
            arb_defs = "/*Begin code section*/
/* Gerador_ensaio: estado do disparo. Roda a 10 us e atualiza a cada 10 chamadas (100 us). */
int gen_ativo = 0;          /* 1 depois da borda de subida de 'disparo' */
long gen_k = 0;             /* passos de 100 us desde o disparo */
double gen_disp_ant = 0.0;  /* valor anterior de 'disparo' */
int gen_div = 0;            /* contador de chamadas */
int gen_calc = 0;
double gen_va = 0.0;        /* saidas retidas entre atualizacoes */
double gen_tl = 0.0;
double gen_mk = 0.0;
/*End code section*/"
            execution_rate = "1e-5"
            init_fnc = "/*Begin code section*/
gen_ativo = 0;
gen_k = 0;
gen_disp_ant = 0.0;
gen_div = 0;
gen_calc = 0;
gen_va = 0.0;
gen_tl = 0.0;
gen_mk = 0.0;
/*End code section*/"
            input_terminals = "real ensaio;real disparo;real Va_man;real TL_man;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True"
            input_terminals_show_labels = "True;True;True;True"
            output_fnc = "/*Begin code section*/
/* ensaio 0: manual (Va_man, TL_man)
   ensaio 1: degrau de Va 0 -> 30 V no disparo
   ensaio 2: inercia livre, Va 30 -> 0 V no disparo (parte do regime em 30 V)
   ensaio 3: pulso de TL = 0,05 N.m por 50 ms no disparo, com Va = 30 V */
if (gen_div == 0) {
    int e_ens = (int)(ensaio + 0.5);
    double va = Va_man;
    double tl = TL_man;
    if (e_ens == 1) {
        va = gen_ativo ? 30.0 : 0.0;
        tl = 0.0;
    } else if (e_ens == 2) {
        va = gen_ativo ? 0.0 : 30.0;
        tl = 0.0;
    } else if (e_ens == 3) {
        va = 30.0;
        tl = (gen_ativo && gen_k < 500) ? 0.05 : 0.0;   /* 500 x 100 us = 50 ms */
    }
    gen_va = va;
    gen_tl = tl;
    gen_mk = gen_ativo ? 1.0 : 0.0;
    gen_calc = 1;
} else {
    gen_calc = 0;
}
Va_cmd = gen_va;
TL_cmd = gen_tl;
marca = gen_mk;
/*End code section*/"
            output_terminals = "real Va_cmd;real TL_cmd;real marca;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True"
            output_terminals_show_labels = "True;True;True"
            update_fnc = "/*Begin code section*/
if (gen_calc) {
    if (disparo > 0.5 && gen_disp_ant <= 0.5) {
        gen_ativo = 1;
        gen_k = 0;
    } else if (disparo <= 0.5) {
        gen_ativo = 0;
        gen_k = 0;
    } else if (gen_ativo) {
        gen_k = gen_k + 1;
    }
    gen_disp_ant = disparo;
}
gen_div = gen_div + 1;
if (gen_div >= 10) gen_div = 0;
/*End code section*/"
        }
