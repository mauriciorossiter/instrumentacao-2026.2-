        component "core/C function" QEI_estimador {
            arb_defs = "/*Begin code section*/
/* QEI_estimador: decodificador + metodo M em janela deslizante + IIR.
   O bloco roda a 10 us (mesma taxa do modelo) e executa a rotina do microcontrolador
   a cada 10 chamadas, ou seja, com periodo de 100 us. */
double est_dbuf[4096];      /* incrementos de contagem de cada passo (janela maxima de 409,5 ms) */
int est_idx = 0;            /* proxima posicao livre do historico */
int est_ok = 0;             /* 0 ate a primeira amostra */
int est_M = 0;              /* largura da janela usada no passo anterior, em passos */
double est_S = 0.0;         /* soma dos incrementos dentro da janela */
double est_Nant = 0.0;      /* ultima leitura do encoder */
double est_pos = 0.0;       /* registrador de posicao do QEI, modulo 4*CPR */
double est_y = 0.0;         /* estado do filtro IIR, rad/s */
double est_dN_nov = 0.0;    /* valores calculados em output_fnc e gravados em update_fnc */
double est_N_nov = 0.0;
double est_S_nov = 0.0;
double est_pos_nov = 0.0;
double est_y_nov = 0.0;
int est_M_nov = 0;
int est_div = 0;            /* contador de chamadas: a rotina roda quando vale 0 */
int est_calc = 0;           /* 1 na chamada em que a rotina rodou */
/*End code section*/"
            execution_rate = "1e-5"
            init_fnc = "/*Begin code section*/
est_idx = 0;
est_ok = 0;
est_M = 0;
est_S = 0.0;
est_Nant = 0.0;
est_pos = 0.0;
est_y = 0.0;
est_dN_nov = 0.0;
est_N_nov = 0.0;
est_S_nov = 0.0;
est_pos_nov = 0.0;
est_y_nov = 0.0;
est_M_nov = 0;
est_div = 0;
est_calc = 0;
/*End code section*/"
            input_terminals = "real N_enc;real CPR;real Tw_ms;real fmax_kHz;real fc_Hz;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True"
            output_fnc = "/*Begin code section*/
const double EST_TS = 1e-4;             /* periodo da rotina do microcontrolador, s */
const double EST_PI2 = 6.283185307179586;
int i, k, M, j;
double R, dN, dmax, S, w_raw, a, y, pos;
if (est_div == 0) {
    R = 4.0 * CPR;                          /* contagens por volta (x4) */
    if (!est_ok) {                          /* primeira amostra: historico parado */
        for (i = 0; i < 4096; i++) est_dbuf[i] = 0.0;
        est_Nant = N_enc;
        est_S = 0.0;
        est_M = 0;
        est_pos = 0.0;
        est_y = 0.0;
        est_ok = 1;
    }
    /* 1) QEI: incremento desde a ultima leitura, com a volta do contador */
    dN = N_enc - est_Nant;
    if (dN > 0.5 * R) dN = dN - R;
    if (dN < -0.5 * R) dN = dN + R;
    /* frequencia maxima de contagem: no maximo 4*fmax bordas por segundo (fmax_kHz = 0 desliga) */
    if (fmax_kHz > 0.0) {
        dmax = 4.0 * fmax_kHz * 1e3 * EST_TS;
        if (dN > dmax) dN = dmax;
        if (dN < -dmax) dN = -dmax;
    }
    /* 2) metodo M em janela deslizante: w = (soma dos ultimos M incrementos) * (2*pi/R) / (M*EST_TS) */
    M = (int)(Tw_ms * 1e-3 / EST_TS + 0.5);
    if (M < 1) M = 1;
    if (M > 4095) M = 4095;
    if (M == est_M) {
        j = est_idx - M;
        if (j < 0) j = j + 4096;
        S = est_S + dN - est_dbuf[j];       /* entra o incremento novo, sai o mais antigo */
    } else {
        S = dN;                             /* janela mudou: soma refeita */
        for (i = 1; i < M; i++) {
            k = est_idx - i;
            if (k < 0) k = k + 4096;
            S = S + est_dbuf[k];
        }
    }
    w_raw = S * (EST_PI2 / R) / (M * EST_TS);
    /* 3) filtro IIR de 1a ordem, fc_Hz = 0 desliga */
    if (fc_Hz > 0.0) {
        a = 1.0 - exp(-EST_PI2 * fc_Hz * EST_TS);
    } else {
        a = 1.0;
    }
    y = est_y + a * (w_raw - est_y);
    pos = est_pos + dN;
    if (pos >= R) pos = pos - R;
    if (pos < 0.0) pos = pos + R;
    est_dN_nov = dN;
    est_N_nov = N_enc;
    est_S_nov = S;
    est_M_nov = M;
    est_pos_nov = pos;
    est_y_nov = y;
    w_est = y;
    N_qei = pos;
    est_calc = 1;
} else {
    w_est = est_y;                      /* entre execucoes, a saida fica retida */
    N_qei = est_pos;
    est_calc = 0;
}
/*End code section*/"
            output_terminals = "real w_est;real N_qei;"
            output_terminals_dimensions = "inherit;inherit"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
            update_fnc = "/*Begin code section*/
if (est_calc) {
    est_dbuf[est_idx] = est_dN_nov;
    est_idx = est_idx + 1;
    if (est_idx >= 4096) est_idx = 0;
    est_S = est_S_nov;
    est_M = est_M_nov;
    est_Nant = est_N_nov;
    est_pos = est_pos_nov;
    est_y = est_y_nov;
}
est_div = est_div + 1;
if (est_div >= 10) est_div = 0;
/*End code section*/"
        }
