        component "core/C function" HEDS5540 {
            arb_defs = "/*Begin code section*/
/* HEDS5540: angulo do disco, mantido em [0, 2*pi) (passo de 10 us) */
double dsk_th = 0.0;        /* angulo do eixo, rad */
double dsk_w_nov = 0.0;     /* velocidade lida em output_fnc, usada em update_fnc */
/*End code section*/"
            execution_rate = "1e-5"
            init_fnc = "/*Begin code section*/
dsk_th = 0.0;
dsk_w_nov = 0.0;
/*End code section*/"
            input_terminals = "real w;real CPR;real dTheta_arcmin;real dS_e;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True"
            input_terminals_show_labels = "True;True;True;True"
            output_fnc = "/*Begin code section*/
/* HEDS-5540 (passo de 10 us): o disco gira com o eixo e gera a posicao em contagens.
   - erro de posicao (excentricidade): dTheta_arcmin * sen(theta), 1 ciclo por volta
   - erro de largura de estado: bordas impares deslocadas de dS_e graus eletricos */
const double DSK_PI2 = 6.283185307179586;
double th = dsk_th;
double K, x, s, p, base, pw;
if (CPR > 0.0) {
    th = dsk_th + dTheta_arcmin * (DSK_PI2 / 21600.0) * sin(dsk_th);  /* 1 arcmin = 2*pi/21600 rad */
    K = 4.0 * CPR / DSK_PI2;          /* contagens (x4) por radiano */
    x = K * th;                       /* posicao em contagens, 0 a 4*CPR */
    s = dS_e / 90.0;                  /* deslocamento da borda, em contagens (90 graus eletricos = 1 contagem) */
    if (s > 0.9) s = 0.9;
    if (s < -0.9) s = -0.9;
    p = x - 2.0 * floor(0.5 * x);     /* posicao dentro do par de estados, 0 <= p < 2 */
    base = x - p;
    if (p < 1.0 + s) {
        pw = p / (1.0 + s);
    } else {
        pw = 1.0 + (p - 1.0 - s) / (1.0 - s);
    }
    th = (base + pw) / K;
}
theta_e = th;
theta_eixo = dsk_th;
dsk_w_nov = w;
/*End code section*/"
            output_terminals = "real theta_e;real theta_eixo;"
            output_terminals_dimensions = "inherit;inherit"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
            update_fnc = "/*Begin code section*/
/* integra a velocidade (Euler, 10 us) e mantem o angulo em uma volta */
dsk_th = dsk_th + 1e-5 * dsk_w_nov;
if (dsk_th >= 6.283185307179586) dsk_th = dsk_th - 6.283185307179586;
if (dsk_th < 0.0) dsk_th = dsk_th + 6.283185307179586;
/*End code section*/"
        }
