        component "core/C function" Gerador_ensaio {
            arb_defs = "/*Begin code section*/
/* Gerador_ensaio (entrega final): ensaios de malha aberta (E03) e de malha fechada (E04).
   Roda a 10 us e atualiza a cada 10 chamadas (100 us). */
int gen_ativo = 0;          /* 1 depois da borda de subida de \'disparo\' */
long gen_k = 0;             /* passos de 100 us desde o disparo */
double gen_disp_ant = 0.0;  /* valor anterior de \'disparo\' */
int gen_div = 0;            /* contador de chamadas */
int gen_calc = 0;
double gen_ref = 0.0;       /* saidas retidas entre atualizacoes */
double gen_va = 0.0;
double gen_tl = 0.0;
double gen_mk = 0.0;
/*End code section*/"
            execution_rate = "1e-5"
            init_fnc = "/*Begin code section*/
gen_ativo = 0;
gen_k = 0;
gen_disp_ant = 0.0;
gen_div = 0;
gen_calc = 0;
gen_ref = 0.0;
gen_va = 0.0;
gen_tl = 0.0;
gen_mk = 0.0;
/*End code section*/"
            input_terminals = "real ensaio;real disparo;real malha;real w_ref_man;real Va_man;real TL_man;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True"
            output_fnc = "/*Begin code section*/
/* malha = 0 (aberta, ensaios da E03; o controlador nao age):
     ensaio 0: manual (Va_man, TL_man)
     ensaio 1: degrau de Va 0 -> 30 V no disparo
     ensaio 2: inercia livre, Va 30 -> 0 V no disparo
     ensaio 3: pulso de TL = 0,05 N.m por 50 ms no disparo, com Va = 30 V
   malha = 1 (fechada, ensaios da E04; Va vem do controlador):
     ensaio 0: manual (w_ref_man, TL_man)
     ensaio 1: degrau de referencia 0 -> 400 rad/s no disparo
     ensaio 2: degrau de carga TL 0 -> 0,05 N.m no disparo, referencia 400 rad/s
     ensaio 3: degrau pequeno de referencia 400 -> 420 rad/s no disparo */
if (gen_div == 0) {
    int e_ens = (int)(ensaio + 0.5);
    double r = 0.0;
    double va = 0.0;
    double tl = TL_man;
    if (malha < 0.5) {
        va = Va_man;
        if (e_ens == 1) {
            va = gen_ativo ? 30.0 : 0.0;
            tl = 0.0;
        } else if (e_ens == 2) {
            va = gen_ativo ? 0.0 : 30.0;
            tl = 0.0;
        } else if (e_ens == 3) {
            va = 30.0;
            tl = (gen_ativo && gen_k < 500) ? 0.05 : 0.0;   /* 500 x 100 us = 50 ms */
        }
    } else {
        r = w_ref_man;
        if (e_ens == 1) {
            r = gen_ativo ? 400.0 : 0.0;
            tl = 0.0;
        } else if (e_ens == 2) {
            r = 400.0;
            tl = gen_ativo ? 0.05 : 0.0;
        } else if (e_ens == 3) {
            r = gen_ativo ? 420.0 : 400.0;
            tl = 0.0;
        }
    }
    gen_ref = r;
    gen_va = va;
    gen_tl = tl;
    gen_mk = gen_ativo ? 1.0 : 0.0;
    gen_calc = 1;
} else {
    gen_calc = 0;
}
w_ref = gen_ref;
Va_ma = gen_va;
TL_cmd = gen_tl;
marca = gen_mk;
/*End code section*/"
            output_terminals = "real w_ref;real Va_ma;real TL_cmd;real marca;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True"
            output_terminals_show_labels = "True;True;True;True"
            update_fnc = "/*Begin code section*/
if (gen_calc) {
    if (disparo > 0.5 && gen_disp_ant <= 0.5) {
        gen_ativo = 1;
        gen_k = 0;
    } else if (disparo <= 0.5) {
        gen_ativo = 0;
        gen_k = 0;
    } else if (gen_ativo) {
        gen_k = gen_k + 1;
    }
    gen_disp_ant = disparo;
}
gen_div = gen_div + 1;
if (gen_div >= 10) gen_div = 0;
/*End code section*/"
        }
        [
