<ui_settings>
    <version>2.9</version>
    <model_locked>False</model_locked>
    <canvas_bg_color>#ffffff</canvas_bg_color>
    <initialization_code><![CDATA[# NOTE: Variables and functions defined here will be
# available for use in all Macro and Expression scripts.
# NOTE: This code is always executed prior to simulation start.

# The variable 'SETTINGS_DIR' holds the directory where the loaded Panel .cus file is located.
# Also you can call the 'get_settings_dir_path()' function in any
# Macro and Expression script to get the same directory.
SETTINGS_DIR = get_settings_dir_path()

# The 'add_to_python_path(folder)' function can be used to add a custom folder
# with Python files and packages to the PYTHONPATH. After a folder is added, all Python
# files and Python packages from it can be imported into the SCADA Namespace.

# HIL API is imported as 'hil'
# SCADA API is imported as 'panel'
# SCADA API constants are imported as 'api_const'
# Numpy module is imported as 'np'
# Scipy module is imported as 'sp'
# Schematic Editor model namespace is imported as 'scm'
# Function for printing to the HIL SCADA Message log is imported as 'printf'.

# cenarios do seletor 'cenario' (mesmos valores de casos_final.py)
CENARIOS_G06 = {0: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 0.0}, 1: {'quant_on': 1.0, 'CPR': 500.0, 'dTheta_arcmin': 10.0, 'dS_e': 5.0, 'sigma_cnt': 0.02, 'fmax_kHz': 100.0, 'Tw_ms': 10.0, 'fc_Hz': 0.0, 'carga_on': 1.0, 'comp_on': 0.0, 'fb_real': 1.0}, 2: {'quant_on': 1.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 3: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 10.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 4: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 5.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 5: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.02, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 6: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 100.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 7: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 10.0, 'fc_Hz': 0.0, 'carga_on': 0.0, 'comp_on': 0.0, 'fb_real': 1.0}, 8: {'quant_on': 0.0, 'CPR': 500.0, 'dTheta_arcmin': 0.0, 'dS_e': 0.0, 'sigma_cnt': 0.0, 'fmax_kHz': 0.0, 'Tw_ms': 0.1, 'fc_Hz': 0.0, 'carga_on': 1.0, 'comp_on': 0.0, 'fb_real': 1.0}, 9: {'quant_on': 1.0, 'CPR': 500.0, 'dTheta_arcmin': 10.0, 'dS_e': 5.0, 'sigma_cnt': 0.02, 'fmax_kHz': 100.0, 'Tw_ms': 10.0, 'fc_Hz': 0.0, 'carga_on': 1.0, 'comp_on': 1.0, 'fb_real': 1.0}}
NOMES_CENARIO_G06 = {0: 'instrumento ideal: tudo desligado, realimenta w_ideal', 1: 'instrumento real nominal: todas as caracteristicas ligadas', 2: 'so resolucao: 500 CPR x4, contagem inteira', 3: 'so erro de posicao do disco: 10 arcmin', 4: 'so erro de largura de estado: 5 graus eletricos', 5: 'so entrada espuria: jitter de borda 0,02 contagem (EMI)', 6: 'so frequencia maxima de contagem: 100 kHz', 7: 'so janela do estimador M: Tw = 10 ms (processamento)', 8: 'so carregamento: inercia do disco 0,6 g.cm2', 9: 'real nominal + compensador de avanco (1+5ms s)/(1+3ms s)'}
printf('G06 - entrega final. Cenarios do seletor:')
printf('  0: instrumento ideal: tudo desligado, realimenta w_ideal')
printf('  1: instrumento real nominal: todas as caracteristicas ligadas')
printf('  2: so resolucao: 500 CPR x4, contagem inteira')
printf('  3: so erro de posicao do disco: 10 arcmin')
printf('  4: so erro de largura de estado: 5 graus eletricos')
printf('  5: so entrada espuria: jitter de borda 0,02 contagem (EMI)')
printf('  6: so frequencia maxima de contagem: 100 kHz')
printf('  7: so janela do estimador M: Tw = 10 ms (processamento)')
printf('  8: so carregamento: inercia do disco 0,6 g.cm2')
printf('  9: real nominal + compensador de avanco (1+5ms s)/(1+3ms s)')

]]></initialization_code>
