        <component_data>
                <id>76ab93cd68c14594b83fc82d0736a40d</id>
                <name><![CDATA[Ensaio | MA: 1 Va 0-30 V, 2 Va 30-0 V, 3 pulso TL | MF: 1 ref 0-400, 2 carga, 3 ref 400-420]]></name>
