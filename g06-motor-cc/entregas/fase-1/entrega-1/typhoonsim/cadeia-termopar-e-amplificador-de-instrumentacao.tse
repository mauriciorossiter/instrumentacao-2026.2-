version = 4.2

//
// Saved by sw version: 2026.2
//

model "Cadeia termopar e amplificador de instrumentacao" {
    configuration {
        hil_device = "HIL404"
        hil_configuration_id = 6
        simulation_method = exact
        simulation_time_step = auto
        simulation_discret_scaling = 1.0
        dsp_timer_periods = 100e-6, 50e-3
        ss_calc_method = "systematic elimination"
        enb_pole_shift = True
        enb_gds_oversampling = True
        show_modes = False
        device_ao_limit_enable = False
        reset_analog_outputs_on_sim_stop = True
        reset_analog_outputs_on_sim_stop_mode = Offset values
        reset_digital_outputs_on_sim_stop = True
        vhil_adio_loopback = False
        dma_enable = False
        cpl_stb = False
        enb_dep_sw_detect = False
        code_section = "internal memory"
        data_section = "internal memory"
        sys_sp_rate_1 = 0.0001
        sys_sp_rate_2 = 0.05
        sys_real_type_precision = "default"
        user_real_type_precision = "default"
        sys_cpu_optimization = "high"
        user_cpu_optimization = "high"
        user_cpu_part_option = "default"
        matrix_based_reduction = True
        cpl_dynamics_analysis = False
        export_ss_to_pickle = False
        ground_scope_core = False
        dss_num_tol = 1e-15
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_term_var_location = "local"
        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 1e-4
        simulation_time = 1.0
        abs_tol = 1e-3
        rel_tol = 1e-3
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Ramp" T_sweep {
            slope = "30"
            start_time = "2"
        }
        [
            position = 7868, 8080
        ]

        component "core/Gain" Gain_TC {
            gain = "40.6e-6"
        }
        [
            position = 7960, 8080
        ]

        component "core/Gain" Gain_stage1 {
            gain = "494.07"
        }
        [
            position = 8052, 8080
        ]

        component "core/Gain" Gain_stage2 {
        }
        [
            position = 8136, 8080
        ]

        component "core/Min Max" "Min Sat" {
        }
        [
            position = 8220, 8088
        ]

        component "core/Min Max" "Max Sat" {
            operation = "max"
        }
        [
            position = 8324, 8096
        ]

        component "core/Constant" Constant1 {
            value = "0"
        }
        [
            position = 8284, 8168
            rotation = left
        ]

        component "core/Constant" Constant2 {
            value = "5"
        }
        [
            position = 8180, 8168
            rotation = left
        ]

        component "core/Probe" v_out {
        }
        [
            position = 8404, 8096
        ]

        component "core/Probe" Probe_T {
        }
        [
            position = 7940, 8156
        ]

        component "core/Probe" V_in {
        }
        [
            position = 8040, 8156
        ]

        junction Junction1 sp
        [
            position = 7908, 8080
        ]

        junction Junction2 sp
        [
            position = 7996, 8080
        ]

        connect Gain_stage2.out "Min Sat.in" as Connection1
        connect "Min Sat.out" "Max Sat.in" as Connection3
        connect Constant2.out "Min Sat.in1" as Connection4
        connect Constant1.out "Max Sat.in1" as Connection5
        connect "Max Sat.out" v_out.in as Connection6
        connect Gain_stage1.out Gain_stage2.in as Connection9
        connect T_sweep.out Junction1 as Connection10
        connect Junction1 Gain_TC.in as Connection11
        connect Probe_T.in Junction1 as Connection12
        connect Gain_TC.out Junction2 as Connection13
        connect Junction2 Gain_stage1.in as Connection14
        connect V_in.in Junction2 as Connection15
        [
            breakpoints = 7996, 8156; 7996, 8080
        ]
    }

    default {
        "core/Constant" {
            value = "1"
            signal_type = "real"
            execution_rate = "100e-6"
            _tunable = "False"
        }

        "core/Gain" {
            gain = "1"
            multiplication = "Element-wise(K.*u)"
            force_tml = "True"
            _tunable = "False"
            execution_rate = "inherit"
        }

        "core/Min Max" {
            operation = "min"
            inputs = "2"
            execution_rate = "inherit"
        }

        "core/Probe" {
            signal_access = "inherit"
            addr = "0"
            override_signal_name = "False"
            signal_name = ""
            signal_type = "generic"
            streaming_en = "False"
            streaming_er_idx = "0"
            execution_rate = "inherit"
        }

        "core/Ramp" {
            slope = "1"
            start_time = "0"
            initial_output = "0"
            execution_rate = "100e-6"
        }
    }
}
