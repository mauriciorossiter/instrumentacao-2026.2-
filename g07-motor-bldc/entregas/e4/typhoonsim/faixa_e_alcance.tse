    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        # Cadeia de medicao (Tabela 4 do relatorio)
        f_clk = 1.0e6          # Hz  - clock do timer de captura
        p = 4                  # pares de polos
        N = 6.0 * p            # 24 bordas Hall por revolucao
        M_max = 2**16 - 1      # 65535 (contador de 16 bits)
        
        # Limites da faixa - DERIVADOS, nao digitados
        n_min = 60.0 * f_clk / (N * M_max)   # ~38.15 rpm
        n_max = 4000.0                        # rpm (velocidade nominal)
        A = n_max - n_min                     # ~3961.85 rpm
        
        # Estimulo e simulacao
        Ts = 100e-6            # passo de execucao (10 kHz)
        x_hi = 4200.0          # varre APENAS 0 a 80 rpm
        T_sweep = 40.0
        f_tri = 1.0 / T_sweep
        
        print("n_min=%.4f  n_max=%.1f  A=%.4f" % (n_min, n_max, A))
    ENDCODE
