    CODE model_init

        import math as g07_math
        g07_dt = 0.01
        g07_Tinit = 0.0
        g07_ensaio = 0  # 0=degraus termicos; 1=varredura estatica; 2=temperatura constante, ruido 1/f
        g07_R_25 = 10000.0
        g07_B_ntc = 3988.0
        g07_V_exc = 2.5
        g07_R_f = 1470.0
        g07_R_ntc_Tmin = g07_R_25*g07_math.exp(g07_B_ntc*(1.0/273.15-1.0/298.15))
        g07_R_th = g07_R_f*g07_R_ntc_Tmin/(g07_R_f+g07_R_ntc_Tmin)
        C_c = 100e-12
        R_c = 100.0
        cobertura = 0.95
        C_res = (1.0-cobertura)*C_c
        C_1s = C_c
        C_2s = 100e-12
        R_sh = 0.1

        # Entrega 02, G07. Curva nominal 8016: TDK S861, p.6.
        # tau=15s em ar (p.2); valor da montagem no motor requer ensaio.
        # sigma1f=100uV RMS NOMINAL: estimativa didatica, nao dado de catalogo.
        g07_tau = 15.0
        g07_sigma = 100e-6
        g07_every = int(round(0.01/g07_dt))
        info("G07 E2: R/T 8016 | tau=15 s (ar) | 1/f nominal=100 uV RMS (estimativa) | dt=%.6g s" % g07_dt)
    ENDCODE
}
