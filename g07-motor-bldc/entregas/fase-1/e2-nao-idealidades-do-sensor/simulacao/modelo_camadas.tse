g07_ideal = g07_Vexc*g07_Rf/(g07_Rf+g07_Raux);
g07_q = g07_TC;
if (g07_q < 0.0) g07_q = 0.0;
if (g07_q > 130.0) g07_q = 130.0;
g07_j = (int)(g07_q/5.0);
if (g07_j > 25) g07_j = 25;
g07_q = g07_q/5.0 - g07_j;
g07_Raux = g07_R25*exp((1.0-g07_q)*log(g07_ratio[g07_j]) + g07_q*log(g07_ratio[g07_j+1]));
g07_estatica = g07_Vexc*g07_Rf/(g07_Rf+g07_Raux);
