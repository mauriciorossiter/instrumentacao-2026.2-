        component "core/C function" G07_Acoplamento {
            execution_rate = "Ts*10"
            global_variables = "real g07_thm;real g07_te;real g07_ang;real g07_f[3];int g07_q;"
            init_fnc = "g07_thm = 0.0;"
            input_terminals = "real ia;real ib;real ic;real im;real kfat;real dR;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True"
            output_fnc = "w = im / g07_KI;
theta_m = g07_thm;
g07_te = g07_p * g07_thm;
while (g07_te >= 6.283185307179586) g07_te = g07_te - 6.283185307179586;
for (g07_q = 0; g07_q < 3; g07_q++) {
    g07_ang = g07_te - g07_q * 2.0943951023931953;
    if (g07_ang < 0.0) g07_ang = g07_ang + 6.283185307179586;
    g07_ang = g07_ang * 57.29577951308232;
    if (g07_ang < 30.0) g07_f[g07_q] = g07_ang / 30.0;
    else if (g07_ang < 150.0) g07_f[g07_q] = 1.0;
    else if (g07_ang < 210.0) g07_f[g07_q] = (180.0 - g07_ang) / 30.0;
    else if (g07_ang < 330.0) g07_f[g07_q] = -1.0;
    else g07_f[g07_q] = (g07_ang - 360.0) / 30.0;
}
e_a = kfat * g07_kph * w * g07_f[0];
e_b = kfat * g07_kph * w * g07_f[1];
e_c = kfat * g07_kph * w * g07_f[2];
Te = kfat * g07_kph * (g07_f[0] * ia + g07_f[1] * ib + g07_f[2] * ic);
vdR_a = dR * ia;
vdR_b = dR * ib;
vdR_c = dR * ic;"
            output_terminals = "real e_a;real e_b;real e_c;real Te;real vdR_a;real vdR_b;real vdR_c;real w;real theta_m;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True;True;True;True;True"
            parameters = "real g07_kph;real g07_KI;real g07_Tc;real g07_p;"
            update_fnc = "g07_thm = g07_thm + g07_Tc * im / g07_KI;
while (g07_thm >= 6.283185307179586) g07_thm = g07_thm - 6.283185307179586;
while (g07_thm < 0.0) g07_thm = g07_thm + 6.283185307179586;"
        }
        [
            position = 10760, 8000
            size = 128, 288
        ]

