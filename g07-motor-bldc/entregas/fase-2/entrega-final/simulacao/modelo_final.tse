        component "core/C function" G07_C2_ADC {
            execution_rate = "Ts"
            global_variables = "int gc2_k;int gc2_M;int gc2_N;int gc2_L;real gc2_lsb;real gc2_h;real gc2_hi;real gc2_x;real gc2_xi;real gc2_z;"
            init_fnc = "gc2_k = 0;gc2_h = 2.5;gc2_hi = 2.5;"
            input_terminals = "real v_in;real i;real fs;real nb;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True"
            input_terminals_show_labels = "True;True;True;True"
            output_fnc = "if (fs <= 0.0) {
gc2_x = v_in;
gc2_xi = g07_VQ + g07_S0*i;
novo = 1.0;
} else {
gc2_M = (int)(1.0/(fs*1000.0*g07_Tsen) + 0.5);
if (gc2_M < 1) gc2_M = 1;
if (gc2_k % gc2_M == 0) {
gc2_h = v_in;
gc2_hi = g07_VQ + g07_S0*i;
novo = 1.0;
} else {
novo = 0.0;
}
gc2_k = gc2_k + 1;
if (gc2_k >= 1000000000) gc2_k = 0;
gc2_x = gc2_h;
gc2_xi = gc2_hi;
}
if (gc2_x < 0.0) gc2_x = 0.0;
if (gc2_x > 5.0) gc2_x = 5.0;
if (gc2_xi < 0.0) gc2_xi = 0.0;
if (gc2_xi > 5.0) gc2_xi = 5.0;
if (nb > 0.5) {
gc2_N = (int)(nb + 0.5);
gc2_L = 1 << gc2_N;
gc2_lsb = 5.0/gc2_L;
gc2_x = ((int)(gc2_x/gc2_lsb + 0.5))*gc2_lsb;
if (gc2_x > 5.0 - gc2_lsb) gc2_x = 5.0 - gc2_lsb;
gc2_N = (int)(nb + 0.5);
gc2_L = 1 << gc2_N;
gc2_lsb = 5.0/gc2_L;
gc2_xi = ((int)(gc2_xi/gc2_lsb + 0.5))*gc2_lsb;
if (gc2_xi > 5.0 - gc2_lsb) gc2_xi = 5.0 - gc2_lsb;
}
v = gc2_x;
iso = (gc2_xi - g07_VQ)/g07_S0;
gc2_z = g07_VQ + g07_S0*i;
gc2_N = (int)(g07_R5_nb1 + 0.5);
gc2_L = 1 << gc2_N;
gc2_lsb = 5.0/gc2_L;
gc2_z = ((int)(gc2_z/gc2_lsb + 0.5))*gc2_lsb;
if (gc2_z > 5.0 - gc2_lsb) gc2_z = 5.0 - gc2_lsb;
r1 = (gc2_z - g07_VQ)/g07_S0;
gc2_z = g07_VQ + g07_S0*i;
gc2_N = (int)(g07_R5_nb2 + 0.5);
gc2_L = 1 << gc2_N;
gc2_lsb = 5.0/gc2_L;
gc2_z = ((int)(gc2_z/gc2_lsb + 0.5))*gc2_lsb;
if (gc2_z > 5.0 - gc2_lsb) gc2_z = 5.0 - gc2_lsb;
r2 = (gc2_z - g07_VQ)/g07_S0;
gc2_z = g07_VQ + g07_S0*i;
gc2_N = (int)(g07_R5_nb3 + 0.5);
gc2_L = 1 << gc2_N;
gc2_lsb = 5.0/gc2_L;
gc2_z = ((int)(gc2_z/gc2_lsb + 0.5))*gc2_lsb;
if (gc2_z > 5.0 - gc2_lsb) gc2_z = 5.0 - gc2_lsb;
r3 = (gc2_z - g07_VQ)/g07_S0;
"
            output_terminals = "real v;real iso;real novo;real r1;real r2;real r3;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True"
