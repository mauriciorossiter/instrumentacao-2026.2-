            init_fnc = "gp1b_kc = 0;gp1b_nacc = 0;gp1b_tem = 0;gp1b_acc = 0.0;gp1b_Va = 2.5;gp1b_p = 0;for (gp1b_q = 0; gp1b_q < 64; gp1b_q++) gp1b_buf[gp1b_q] = 0.0;"
            input_terminals = "real v_adc;real novo;real eS;real eQ;real T;real corr;real fs;real cal;real acal;"
