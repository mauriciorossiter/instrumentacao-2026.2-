        component "core/C function" G07_Partida_numerica {
            execution_rate = "Ts*10"
            global_variables = "int g07_start_ticks;real g07_Tp;"
            init_fnc = "g07_start_ticks = 0;g07_Tp = 0.0;"
            input_terminals = ""
            input_terminals_dimensions = ""
            input_terminals_feedthrough = ""
            input_terminals_show_labels = ""
            output_fnc = "g07_Tp = ((g07_modo == 3 || g07_modo == 4 || g07_modo == 5) && g07_start_ticks >= g07_N_p1 && g07_start_ticks < g07_N_p2) ? g07_Td : 0.0;
out = ((g07_start_ticks < g07_start_N) ? g07_start_torque : 0.0) + g07_Tp;"
            output_terminals_dimensions = "(1,)"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            parameters = "real g07_start_torque;int g07_start_N;int g07_modo;real g07_Td;int g07_N_p1;int g07_N_p2;"
            update_fnc = "if (g07_start_ticks < 2000000000) g07_start_ticks = g07_start_ticks + 1;"
        }
