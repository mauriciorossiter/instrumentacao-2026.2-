            size = 60, 20
        ]
        component "core/C function" G07_CL_referencia {
            execution_rate = "Ts"
            global_variables = "real gr_t;real gr_tau;int gr_j;"
            init_fnc = "gr_t = 0.0;"
            input_terminals = "real eQ_sc;real fcrc_sc;real sg_sc;real acal;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True"
            input_terminals_show_labels = "True;True;True;True"
            output_fnc = "gr_t = gr_t + g07_Tsen;
cal = 0.0;
dd = 0.0;
eQ = eQ_sc;
fcrc = fcrc_sc;
sg = sg_sc;
if (g07_cl_ens == 1) {
iref = (gr_t < g07_t_ref) ? g07_iref0 : g07_iref1;
if (gr_t >= g07_t_dd1 && gr_t < g07_t_dd2) dd = g07_dd;
if (acal > 0.5 && gr_t < g07_t_cal) {
cal = 1.0;
iref = 0.0;
}
} else {
iref = g07_iref0;
if (acal > 0.5 && gr_t < g07_t_cal) {
cal = 1.0;
iref = 0.0;
}
if (gr_t >= g07_t_ini) {
gr_j = (int)((gr_t - g07_t_ini)/g07_T_nivel);
if (gr_j > 3) gr_j = 3;
gr_tau = gr_t - g07_t_ini - gr_j*g07_T_nivel;
if (gr_tau >= g07_tv_degrau) iref = g07_iref1;
if (gr_tau >= g07_tv_dd1 && gr_tau < g07_tv_dd2) dd = g07_dd;
if (acal > 0.5 && gr_tau < g07_t_cal) {
cal = 1.0;
iref = 0.0;
}
if (g07_cl_ens == 2) eQ = (gr_j == 0) ? g07_v_eQ0 : ((gr_j == 1) ? g07_v_eQ1 : ((gr_j == 2) ? g07_v_eQ2 : g07_v_eQ3));
if (g07_cl_ens == 3) fcrc = (gr_j == 0) ? g07_v_rc0 : ((gr_j == 1) ? g07_v_rc1 : ((gr_j == 2) ? g07_v_rc2 : g07_v_rc3));
if (g07_cl_ens == 4) sg = (gr_j == 0) ? g07_v_sg0 : ((gr_j == 1) ? g07_v_sg1 : ((gr_j == 2) ? g07_v_sg2 : g07_v_sg3));
}
}"
            output_terminals = "real iref;real dd;real cal;real eQ;real fcrc;real sg;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True;True"
            parameters = "int g07_cl_ens;real g07_Tsen;real g07_t_ref;real g07_iref0;real g07_iref1;real g07_t_dd1;real g07_t_dd2;real g07_dd;real g07_t_cal;real g07_t_ini;real g07_T_nivel;real g07_tv_degrau;real g07_tv_dd1;real g07_tv_dd2;real g07_v_eQ0;real g07_v_eQ1;real g07_v_eQ2;real g07_v_eQ3;real g07_v_rc0;real g07_v_rc1;real g07_v_rc2;real g07_v_rc3;real g07_v_sg0;real g07_v_sg1;real g07_v_sg2;real g07_v_sg3;"
            update_fnc = ""
        }
