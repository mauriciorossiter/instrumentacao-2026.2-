gp1b_nacc = 0;
}
if (gp1b_tem > 0) gp1b_Vc = gp1b_Va;
}
gp1b_im = (v_adc - gp1b_Vc)/gp1b_Sc;
if (corr > 0.5 && fs > 0.0) {
