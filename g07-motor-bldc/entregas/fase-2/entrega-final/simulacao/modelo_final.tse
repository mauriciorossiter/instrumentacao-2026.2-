    CODE model_init
        info("G07 - Fase 2 / ENTREGA FINAL - instrumentacao nao ideal e seus efeitos no controle de corrente. Executar em tempo real (VHIL) com o HIL SCADA")
        # Numpy -> np ; Schematic API -> mdl ; info() imprime no console
        # ---------------- Parametros do motor (Tab. 1 do relatorio) ----------------
        # Valores NOMINAIS = dossie oficial do Banco de Sistemas (ECOM060).
        # Valores da pagina MOONS (R_LL 2,65 ohm, L_LL 4,1 mH, J 40,17 g.cm2) ficam como alternativa (R5).
        pms = 4                     # pares de polos (8 polos) [dossie = fabricante]
        Rs = 1.60                   # resistencia de fase [ohm] [dossie]
        Ls = 1.90e-3                # indutancia de fase Ls = L - M (neutro isolado) [H] [dossie]
        Kt = 0.048                  # constante de torque [N.m/A] [dossie = fabricante]
        k_eq = Kt                   # k_e = k_t (conservacao de energia) [V.s/rad]
        # Typhoon: Vpk/krpm = FCEM de PICO LINHA-LINHA a 1000 rpm, FCEM trapezoidal.
        # Com duas fases no topo plano, V_LL,pk = 2*E_fase = k*w  ->  Emf = k*1000*2*pi/60 = 5,027 V/krpm.
        # (Converter 4,75 Vrms/krpm supondo forma senoidal, 6,72, daria k = 0,0642: incorreto.)
        Emf = k_eq*1000*2*np.pi/60
        Jm = 3.3e-6                 # inercia do rotor [kg.m2] [dossie]
        Kw = 1e-6                   # atrito viscoso [N.m.s/rad] HIPOTESE: lacuna do dossie (identificar em bancada)
        # ---------------- Acionamento ----------------
        Ts = 5e-6                   # passo de execucao do controle [s]
        f_pwm = 10000               # frequencia PWM [Hz]
        Tpwm = 1/f_pwm
        Vs = 36                     # tensao nominal do barramento [V] [dossie = fabricante]
        # ---------------- Carga: T_L = b2*n^2 (n em rpm) -> 0,08 N.m a 4000 rpm ----------------
        b4 = 0
        b3 = 0
        b2 = 5e-9
        b1 = 0
        b0 = 0
        # polinomio de empuxo herdado do exemplo (nao faz parte da planta caracterizada)
        g = 9.81
        m = 4
        a4 = 2.37e-12
        a3 = -1.084e-8
        a2 = 4.485e-4
        a1 = 0.3360
        a0 = 0
        # ---------------- Selecao de ensaio (Secao R3) ----------------
        # g07_modo = 0 : malha fechada original (referencia Throttle 82,9 % -> 4000 rpm)
        # g07_modo = 1 : degrau em malha aberta, d: g07_d_ini -> g07_d_deg em t = g07_t_deg
        #                (a) a partir do repouso:          g07_d_ini = 0,     g07_d_deg = 0.7074, g07_t_deg = 0
        #                (a') a partir do equilibrio 4000: g07_d_ini = 0.867, g07_d_deg = 0.887,  g07_t_deg = 0.15
        # g07_modo = 2 : condicao inicial nao nula: malha fechada ate g07_t_ci (n = 4000 rpm), depois d = g07_d_ci
        #                (g07_d_ci = 0 -> desaceleracao livre; g07_d_ci = 0.5 -> conducao descontinua e novo equilibrio)
        # g07_modo = 3 : perturbacao: d = g07_d0 fixo, pulso de carga g07_Td em [g07_t_p1, g07_t_p2)
        # g07_modo = 4 : perturbacao em malha fechada (mesmo pulso)
        g07_modo = 5
        g07_d0 = 0.7074             # razao ciclica do equilibrio de 4000 rpm (modelo medio)
        g07_d_ini = 0.0             # razao ciclica antes do degrau (0 = repouso)
        g07_d_deg = 0.7074          # TyphoonSim: ~3620 rpm (PWM quantizado: d_ef = 0,75)
        g07_t_deg = 0.0             # instante do degrau [s]
        g07_t_ci = 0.15
        g07_d_ci = 0.0              # razao ciclica apos g07_t_ci no modo 2 (0 = desaceleracao livre; 0.55 = fora do equilibrio)
        g07_Td = 0.02               # [N.m]
        g07_t_p1 = 0.33
        g07_t_p2 = 0.39
        g07_cl_ens = 1
        g07_hall0 = 0
        g07_comp0 = 0
        g07_N_deg = int(round(g07_t_deg/Ts))
        g07_N_ci = int(round(g07_t_ci/Ts))
        g07_N_p1 = int(round(g07_t_p1/(Ts*10)))
        g07_N_p2 = int(round(g07_t_p2/(Ts*10)))
        # Auxiliar numerico de partida: -1 mN.m durante 1 ms (nao impoe velocidade)
        g07_start_torque = -1e-3
        g07_start_N = int(round(0.001/(Ts*10)))
        info("G07 E01: Rs=%.4f ohm Ls=%.4g H k=%.4f N.m/A Emf=%.4f V/krpm J=%.4g kg.m2 B=%.1g" % (Rs, Ls, k_eq, Emf, Jm, Kw))
        info("G07 E01: modo de ensaio = %d (0 MF, 1 degrau MA, 2 CI, 3 perturbacao MA, 4 perturbacao MF)" % g07_modo)
        # ================= Entrega 02: equivalente eletrico (Tab. 2 do relatorio) =================
        # Analogia forca-tensao: torque -> tensao (K_V), velocidade -> corrente (K_I).
        g07_KV = 100.0                       # V por N.m (0,08 N.m -> 8 V; pico 0,24 N.m -> 24 V)
        g07_KI = 1.0/(1000*2*np.pi/60)       # A por rad/s (1 A <-> 1000 rpm), = 9,5493e-3 A.s/rad
        L_J = Jm*g07_KV/g07_KI               # inercia J  -> indutor  L_J = 34,56 mH
        R_B = Kw*g07_KV/g07_KI               # atrito B   -> resistor R_B = 10,47 mOhm
        g07_kph = k_eq/2                     # FCEM de fase no topo plano: e = (k/2) w f(theta_e)
        g07_p = float(pms)                   # pares de polos (real, para a C function)
        g07_Tc = Ts*10                       # periodo da C function G07_Acoplamento (= taxa do bloco BLDC da E01)
        info("G07 E02: L_J=%.5g H R_B=%.5g ohm K_V=%.1f V/N.m K_I=%.6g A.s/rad" % (L_J, R_B, g07_KV, g07_KI))
        # ================= Entrega 03: sensor Hall de corrente na fase a (ACS712ELCTR-20A-T) =================
        # Valores nominais do datasheet (Allegro ACS712, rev. 16) e do Cap. 7.6/8.2.1 de Aguirre (2013).
        g07_S0 = 0.100            # sensibilidade nominal [V/A] (100 mV/A, versao 20 A)
        g07_VQ = 2.5              # saida a corrente nula [V] (VCC/2, VCC = 5 V)
        g07_dVQ = -0.07e-3        # deriva do zero com a temperatura [V/C] (25 a 150 C)
        g07_dS = -0.004e-3        # deriva da sensibilidade com a temperatura [V/A/C] (25 a 150 C)
        g07_Tsen = Ts             # periodo de execucao da cadeia de medicao [s] (5 us)
        g07_fpwm = float(f_pwm)   # frequencia do PWM [Hz] (media movel por periodo)
        # R5 (exacerbacao): niveis calculados em paralelo, cada um com so a caracteristica exagerada
        g07_R5_fc1 = 10e3         # banda do sensor [Hz]
        g07_R5_fc2 = 2e3
        g07_R5_fc3 = 0.5e3
        g07_R5_sg1 = 0.05         # ruido rms a 200 kS/s [V]
        g07_R5_sg2 = 0.2
        g07_R5_sg3 = 1.0
        g07_R5_nb1 = 8.0          # resolucao do ADC [bit]
        g07_R5_nb2 = 6.0
        g07_R5_nb3 = 4.0
        info("G07 E03: sensor Hall S0=%.3f V/A VQ=%.2f V, cadeia a %.0f kHz" % (g07_S0, g07_VQ, 1e-3/g07_Tsen))
        # ================= Entrega 04: malha de corrente fechada sobre a medicao (ideal ou real) =================
        # Para usar: g07_modo = 5. g07_cl_ens: 1 = sequencia do R3; 2/3/4 = varredura do R4 (zero / filtro RC / ruido).
        # Controlador PI (cancelamento do polo eletrico): wc = 2500 rad/s
        g07_wc = 2500.0
        g07_Kp = g07_wc*(2*Ls)/Vs           # 0,264
        g07_Ki = g07_Kp*(2*Rs)/(2*Ls)       # 222 1/s
        # Sequencia do R3: degrau 1,0 -> 1,5 A; afundamento de 10 % em d; pulso de carga (g07_t_p1/g07_t_p2)
        g07_iref0 = 1.0
        g07_iref1 = 1.5
        g07_t_ref = 0.15
        g07_dd = -0.1
        g07_t_dd1 = 0.25
        g07_t_dd2 = 0.30
        # Autocalibracao de zero (R5): inversor parado por g07_t_cal; media das amostras apos g07_t_cal0
        g07_t_cal = 0.005
        g07_Ncal0 = int(round(0.003/Ts))
        # Varredura do R4: 4 niveis de 0,1 s a partir de 0,1 s
        g07_t_ini = 0.1
        g07_T_nivel = 0.1
        g07_tv_degrau = 0.04
        g07_tv_dd1 = 0.07
        g07_tv_dd2 = 0.085
        g07_v_eQ0 = 10.0                    # desvio de zero efetivo [mV] (calibrado: 10 mV)
        g07_v_eQ1 = 30.0
        g07_v_eQ2 = 60.0
        g07_v_eQ3 = 160.0
        g07_v_rc0 = 15.0                    # filtro RC [kHz]
        g07_v_rc1 = 3.0
        g07_v_rc2 = 1.0
        g07_v_rc3 = 0.3
        g07_v_sg0 = 10.0                    # ruido [mV rms a 200 kS/s]
        g07_v_sg1 = 100.0
        g07_v_sg2 = 300.0
        g07_v_sg3 = 1000.0
        info("G07 E04: malha de corrente Kp=%.4f Ki=%.1f (wc=%.0f rad/s), ensaio %d" % (g07_Kp, g07_Ki, g07_wc, g07_cl_ens))
        # ================= Entrega final: compensacoes do item 8, escolhidas no SCADA =================
        # G07_hall = 1: fase em conducao escolhida pelos sensores Hall de posicao (sem retificar o ruido)
        # G07_comp_rc = 1: medida dividida por |H_RC(f_e)|, com f_e estimada pelo periodo do Hall A
        info("G07 FINAL: modelo unico dos itens 4 a 8; no SCADA: G07_fb_real, G07_autocal, G07_hall, G07_comp_rc")
    ENDCODE
}
