        component "core/C function" G07_S1_sensibilidade {
            execution_rate = "Ts"
            global_variables = "real gs1_k;"
            init_fnc = ""
            input_terminals = "real i;real eS;real T;"
            input_terminals_dimensions = "inherit;inherit;inherit"
