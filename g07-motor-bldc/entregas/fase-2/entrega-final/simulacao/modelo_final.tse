        component "core/C function" G07_Seletor_duty {
            execution_rate = "Ts"
            global_variables = "int g07_sel_ticks;"
            init_fnc = "g07_sel_ticks = 0;"
            input_terminals = "real in;real dc;real cal;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "if (g07_modo == 1) {
    out = (g07_sel_ticks >= g07_N_deg) ? g07_d_deg : g07_d_ini;
} else if (g07_modo == 2) {
    out = (g07_sel_ticks >= g07_N_ci) ? g07_d_ci : in;
} else if (g07_modo == 3) {
    out = g07_d0;
} else if (g07_modo == 5) {
    out = (cal > 0.5) ? 0.0 : dc;
    if (out < 0.0) out = 0.0;
    if (out > 1.0) out = 1.0;
} else {
    out = in;
}"
            output_terminals_dimensions = "inherit"
            parameters = "int g07_modo;real g07_d0;real g07_d_ini;real g07_d_deg;int g07_N_deg;int g07_N_ci;real g07_d_ci;"
            update_fnc = "if (g07_sel_ticks < 2000000000) g07_sel_ticks = g07_sel_ticks + 1;"
        }
