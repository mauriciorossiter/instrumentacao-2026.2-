        component "core/C function" G07_S3_banda {
            execution_rate = "Ts"
            global_variables = "real gs3_y;real gs3_yi;real gs3_w;real gs3_a;real gs3_r1;real gs3_r2;real gs3_r3;"
            init_fnc = "gs3_y = 2.5;gs3_yi = 0.0;gs3_r1 = 0.0;gs3_r2 = 0.0;gs3_r3 = 0.0;"
            input_terminals = "real v_in;real i;real fc;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "if (fc > 0.0) {
gs3_w = 6.283185307*fc*1000.0*g07_Tsen;
gs3_a = gs3_w/(1.0 + gs3_w);
gs3_y = gs3_y + gs3_a*(v_in - gs3_y);
gs3_yi = gs3_yi + gs3_a*(i - gs3_yi);
} else {
gs3_y = v_in;
gs3_yi = i;
}
v = gs3_y;
iso = gs3_yi;
gs3_w = 6.283185307*g07_R5_fc1*g07_Tsen;
gs3_a = gs3_w/(1.0 + gs3_w);
gs3_r1 = gs3_r1 + gs3_a*(i - gs3_r1);
r1 = gs3_r1;
gs3_w = 6.283185307*g07_R5_fc2*g07_Tsen;
gs3_a = gs3_w/(1.0 + gs3_w);
gs3_r2 = gs3_r2 + gs3_a*(i - gs3_r2);
r2 = gs3_r2;
gs3_w = 6.283185307*g07_R5_fc3*g07_Tsen;
gs3_a = gs3_w/(1.0 + gs3_w);
gs3_r3 = gs3_r3 + gs3_a*(i - gs3_r3);
r3 = gs3_r3;
"
            output_terminals = "real v;real iso;real r1;real r2;real r3;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True"
            parameters = "real g07_S0;real g07_VQ;real g07_dVQ;real g07_dS;real g07_Tsen;real g07_fpwm;real g07_R5_fc1;real g07_R5_fc2;real g07_R5_fc3;real g07_R5_sg1;real g07_R5_sg2;real g07_R5_sg3;real g07_R5_nb1;real g07_R5_nb2;real g07_R5_nb3;"
            update_fnc = ""
        }
        [
            position = 10460, 8700
            size = 128, 192
