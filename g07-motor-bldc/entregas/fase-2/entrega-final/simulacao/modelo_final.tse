        component "core/C function" G07_CL_realimentacao {
            execution_rate = "Ts"
            global_variables = "real gfb_ci;real gfb_cr;real gfb_hr;real gfb_hi;int gfb_k;real gfb_hA0;real gfb_fe;real gfb_g;real gfb_v;int gfb_q;"
            init_fnc = "gfb_hr = 0.0;gfb_hi = 0.0;gfb_k = 0;gfb_hA0 = 0.0;gfb_fe = 0.0;gfb_g = 1.0;"
            input_terminals = "real ia_i;real ib_i;real ia_r;real ib_r;real fb;real hA;real hB;real hC;real hall;real crc;real fcrc;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True;True;True;True;True;True"
            output_fnc = "gfb_ci = -(ia_i + ib_i);
gfb_cr = -(ia_r + ib_r);
i_pl = 0.5*((ia_i >= 0.0 ? ia_i : -ia_i) + (ib_i >= 0.0 ? ib_i : -ib_i) + (gfb_ci >= 0.0 ? gfb_ci : -gfb_ci));
i_mod = 0.5*((ia_r >= 0.0 ? ia_r : -ia_r) + (ib_r >= 0.0 ? ib_r : -ib_r) + (gfb_cr >= 0.0 ? gfb_cr : -gfb_cr));
if (hA > 0.5 && hB < 0.5 && hC < 0.5) gfb_hr = ia_r;
else if (hA > 0.5 && hB < 0.5 && hC > 0.5) gfb_hr = -(ib_r);
else if (hA > 0.5 && hB > 0.5 && hC < 0.5) gfb_hr = -(gfb_cr);
else if (hA < 0.5 && hB > 0.5 && hC < 0.5) gfb_hr = ib_r;
else if (hA < 0.5 && hB > 0.5 && hC > 0.5) gfb_hr = -(ia_r);
else if (hA < 0.5 && hB < 0.5 && hC > 0.5) gfb_hr = gfb_cr;
if (hA > 0.5 && hB < 0.5 && hC < 0.5) gfb_hi = ia_i;
else if (hA > 0.5 && hB < 0.5 && hC > 0.5) gfb_hi = -(ib_i);
else if (hA > 0.5 && hB > 0.5 && hC < 0.5) gfb_hi = -(gfb_ci);
else if (hA < 0.5 && hB > 0.5 && hC < 0.5) gfb_hi = ib_i;
else if (hA < 0.5 && hB > 0.5 && hC > 0.5) gfb_hi = -(ia_i);
else if (hA < 0.5 && hB < 0.5 && hC > 0.5) gfb_hi = gfb_ci;
i_hall = gfb_hr;
i_hall_i = gfb_hi;
gfb_k = gfb_k + 1;
if (hA > 0.5 && gfb_hA0 < 0.5) {
if (gfb_k > 20) gfb_fe = 1.0/(gfb_k*g07_Tsen);
gfb_k = 0;
}
gfb_hA0 = hA;
if (gfb_k*g07_Tsen > 0.05) gfb_fe = 0.0;
fe = gfb_fe;
gfb_g = 1.0;
if ((crc > 0.5 || g07_comp0 > 0.5) && fcrc > 0.0) {
gfb_v = 1.0 + (gfb_fe/(fcrc*1000.0))*(gfb_fe/(fcrc*1000.0));
gfb_g = 0.5*(1.0 + gfb_v);
for (gfb_q = 0; gfb_q < 6; gfb_q++) gfb_g = 0.5*(gfb_g + gfb_v/gfb_g);
}
i_mr = ((hall > 0.5 || g07_hall0 > 0.5) ? i_hall : i_mod)*gfb_g;
i_fb = (fb > 0.5) ? i_mr : i_pl;"
            output_terminals = "real i_fb;real i_pl;real i_mr;real i_mod;real i_hall;real i_hall_i;real fe;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True;True;True"
            parameters = "real g07_Tsen;real g07_hall0;real g07_comp0;"
            update_fnc = ""
        }
