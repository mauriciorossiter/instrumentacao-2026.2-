        component "core/C function" G07_P1_processamento {
            execution_rate = "Ts"
            global_variables = "int gp1_kc;int gp1_nacc;int gp1_tem;real gp1_acc;real gp1_Va;real gp1_buf[64];int gp1_p;int gp1_q;int gp1_j;int gp1_L;real gp1_Vc;real gp1_Sc;real gp1_im;real gp1_s;"
            init_fnc = "gp1_kc = 0;gp1_nacc = 0;gp1_tem = 0;gp1_acc = 0.0;gp1_Va = 2.5;gp1_p = 0;for (gp1_q = 0; gp1_q < 64; gp1_q++) gp1_buf[gp1_q] = 0.0;"
            input_terminals = "real v_adc;real novo;real eS;real eQ;real T;real corr;real fs;real cal;real acal;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True;True;True;True"
            output_fnc = "if (corr > 0.5) {
gp1_Vc = g07_VQ + eQ/1000.0 + g07_dVQ*(T - 25.0);
gp1_Sc = g07_S0*(1.0 + eS/100.0) + g07_dS*(T - 25.0);
} else {
gp1_Vc = g07_VQ;
gp1_Sc = g07_S0;
}
if (acal > 0.5) {
if (cal > 0.5) {
gp1_kc = gp1_kc + 1;
if (gp1_kc > g07_Ncal0 && novo > 0.5) {
gp1_acc = gp1_acc + v_adc;
gp1_nacc = gp1_nacc + 1;
}
} else {
if (gp1_nacc > 0) {
gp1_Va = gp1_acc/gp1_nacc;
gp1_tem = 1;
}
gp1_kc = 0;
gp1_acc = 0.0;
gp1_nacc = 0;
}
if (gp1_tem > 0) gp1_Vc = gp1_Va;
}
gp1_im = (v_adc - gp1_Vc)/gp1_Sc;
if (corr > 0.5 && fs > 0.0) {
gp1_L = (int)(fs*1000.0/g07_fpwm + 0.5);
if (gp1_L < 1) gp1_L = 1;
if (gp1_L > 64) gp1_L = 64;
if (novo > 0.5) {
gp1_buf[gp1_p] = gp1_im;
gp1_p = gp1_p + 1;
if (gp1_p >= 64) gp1_p = 0;
}
gp1_s = 0.0;
for (gp1_q = 0; gp1_q < gp1_L; gp1_q++) {
gp1_j = gp1_p - 1 - gp1_q;
if (gp1_j < 0) gp1_j = gp1_j + 64;
gp1_s = gp1_s + gp1_buf[gp1_j];
}
i_med = gp1_s/gp1_L;
} else {
i_med = gp1_im;
}"
            output_terminals = "real i_med;"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            parameters = "int g07_Ncal0;real g07_S0;real g07_VQ;real g07_dVQ;real g07_dS;real g07_Tsen;real g07_fpwm;real g07_R5_fc1;real g07_R5_fc2;real g07_R5_fc3;real g07_R5_sg1;real g07_R5_sg2;real g07_R5_sg3;real g07_R5_nb1;real g07_R5_nb2;real g07_R5_nb3;"
            update_fnc = ""
        }
