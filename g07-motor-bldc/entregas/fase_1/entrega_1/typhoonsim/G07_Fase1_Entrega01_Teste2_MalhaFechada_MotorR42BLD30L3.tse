    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        #Brushless DC machine parameters:
        pms = 4                     #number of machine pole pairs
        Kw = 1e-6                   #friction coefficient (hipotese; datasheet nao informa)
        Jm = 4.017e-6               #inercia do rotor R42BLD30L3: 40,17 g.cm2 (MOONS)
        Rs = 1.325                  #resistencia de fase: 2,65 ohm entre terminais / 2
        Ls = 2.05e-3                #indutancia de fase: 4,1 mH terminal / 2
        Emf = 6.72                  #4,75 V rms/krpm x sqrt(2) -> peak line-to-line back emf developed at a mechanical speed of 1000 rpm [V/krpm]
        
        #Simulation parameters:
        Ts = 5e-6                   #execution rate step
        f_pwm=10000                 #PWM frequency
        Tpwm=1/f_pwm                #PWM time period
        Vs=36                       #tensao nominal do R42BLD30L3
        g=9.81                      #gravity acceleration
        m=4                         #mass of drone
        
        b4=0               # load polynomial coefficient
        b3=0              # load polynomial coefficient
        b2=5e-9                # load polynomial coefficient 
        b1=0                # load polynomial coefficient 
        b0=0                        # load polynomial coefficient 
        
        a4=2.37e-12                 # thrust polynomial coefficient
        a3=-1.084e-8                # thrust polynomial coefficient 
        a2=4.485e-4                 # thrust polynomial coefficient 
        a1=0.3360                   # thrust polynomial coefficient 
        a0=0                        # thrust polynomial coefficient 
        # ---- G07: cadeia Hall + blindagem eletrostatica (Aguirre, Secao 6.5, Fig. 6.21 e 6.26) ----
        R_pu = 4.7e3                # pull-up / resistencia de saida do Hall [ohm]
        C_c = 100e-12               # capacitancia parasita fase -> condutor do Hall, SEM blindagem [F] (Fig. 6.21)
        R_c = 100                   # resistencia serie dos acoplamentos (estabilidade numerica) [ohm]
        cobertura = 0.95            # fracao coberta pela blindagem (datasheet do cabo)
        C_res = (1 - cobertura)*C_c # acoplamento residual fase -> condutor, COM blindagem [F]
        C_1s = C_c                  # capacitancia fase -> blindagem [F] (C1 da Fig. 6.26)
        C_2s = 100e-12              # capacitancia condutor -> blindagem [F] (datasheet do cabo, pF/m x comprimento)
        R_sh = 0.1                  # resistencia da blindagem + ligacao ao terra (ponto unico) [ohm]
    ENDCODE
}
