            layout = dynamic
            component "core/C function" "Current sampling" {
                global_variables = "real I_state;"
                init_fnc = "/*Begin code section*/
I_state = 0;
/*End code section*/"
                input_terminals = "real HallA;inherit HallB;inherit HallC;inherit Ia;inherit Ib;inherit Ic;"
                input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True;True;True;True"
                input_terminals_show_labels = "True;True;True;True;True;True"
                output_fnc = "/*Begin code section*/
I = I_state;
//actual current values that are fed back for comparison with reference current value, based on rotor position

if(HallA==1 && HallB==0 && HallC==0){
    I=Ia;
    }
else if(HallA==1 && HallB==0 && HallC==1){
    I=-Ib;
    }
else if(HallA==1 && HallB==1 && HallC==0){
    I=-Ic;
    }
else if(HallA==0 && HallB==1 && HallC==0){
    I=Ib;
    }
else if(HallA==0 && HallB==1 && HallC==1){
    I=-Ia;
    }
else if(HallA==0 && HallB==0 && HallC==1){
    I=Ic;
    }
I_state = I;
/*End code section*/"
                output_terminals = "inherit I;"
                output_terminals_dimensions = "inherit"
                output_terminals_feedthrough = "True"
