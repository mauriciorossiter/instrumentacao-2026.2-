        }
    }

    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        # ---- G07 - Teste 1: atenuacao do acoplamento capacitivo do ruido de chaveamento ----
        f_pwm = 10000               # frequencia de chaveamento do modelo BLDC [Hz]
        f_ruido = 10e3              # rodar com 10e3, 20e3 e 40e3 (faixa de chaveamento) [Hz]
        A_ruido = 18                # amplitude do ruido [V] = Vs/2, Vs = 36 V (R42BLD30L3) - o sistema e linear
        # ---- G07: cadeia Hall + blindagem eletrostatica (Aguirre, Secao 6.5, Fig. 6.21 e 6.26) ----
        R_pu = 4.7e3                # pull-up / resistencia de saida do Hall [ohm]
        C_c = 100e-12               # capacitancia parasita fase -> condutor do Hall, SEM blindagem [F] (Fig. 6.21)
        R_c = 100                   # resistencia serie dos acoplamentos (estabilidade numerica) [ohm]
        cobertura = 0.95            # fracao coberta pela blindagem (datasheet do cabo)
        C_res = (1 - cobertura)*C_c # acoplamento residual fase -> condutor, COM blindagem [F]
        C_1s = C_c                  # capacitancia fase -> blindagem [F] (C1 da Fig. 6.26)
        C_2s = 100e-12              # capacitancia condutor -> blindagem [F] (datasheet do cabo, pF/m x comprimento)
        R_sh = 0.1                  # resistencia da blindagem + ligacao ao terra (ponto unico) [ohm]
        # ---- valores esperados (aparecem no console ao compilar) ----
        w = 2*np.pi*f_ruido
        Zr = R_c + 1/(1j*w*C_c)
        Vref = A_ruido/Zr/(1/R_pu + 1/Zr)
        Zres = R_c + 1/(1j*w*C_res); Z1 = R_c + 1/(1j*w*C_1s); Z2 = 1/(1j*w*C_2s)
        Y = np.array([[1/R_pu + 1/Zres + 1/Z2, -1/Z2], [-1/Z2, 1/Z2 + 1/Z1 + 1/R_sh]])
        Vout = np.linalg.solve(Y, np.array([A_ruido/Zres, A_ruido/Z1]))[0]
        info("G07 esperado @ %.0f Hz: Vref = %.4f V | Vout = %.5f V | A = %.1f dB" % (f_ruido, abs(Vref), abs(Vout), 20*np.log10(abs(Vref/Vout))))
    ENDCODE
}
