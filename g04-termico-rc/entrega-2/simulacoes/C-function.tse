    component Subsystem Root {
        component "core/C function" "C function1" {
            arb_defs = "/*Begin code section*/
// Declaração dos ganhos e parâmetros de tempo
double Kp = 0.1;
double Ki = 10.0;
double Ts = 0.0001;

// Variável estática para o integrador manter o valor entre passos
static double integral_state = 0.0;
/*End code section*/"
            init_fnc = "/*Begin code section*/
// Zera a variável de estado do integrador
integral_state = 0.0;
/*End code section*/"
            input_terminals = "real ref;real feedback;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True"
            input_terminals_show_labels = "False;False"
            output_fnc = "/*Begin code section*/
// 1. Realimentação Negativa: Erro = Referência - Medição
double error = ref - feedback;

// 2. Cálculo das parcelas Proporcional e Integral
double p_term = Kp * error;
double i_term = Ki * integral_state;

// 3. Atribuição DIRETA para a porta de saída do bloco
control_output = p_term + i_term;

// 4. Saturação (Anti-windup)
if (control_output > 1.0) control_output = 1.0;
if (control_output < 0.0) control_output = 0.0;
/*End code section*/"
            output_terminals = "real control_output;"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "False"
            update_fnc = "/*Begin code section*/
// Integração discreta de Euler: x[k+1] = x[k] + e[k] * Ts
double error = ref - feedback;
integral_state += error * Ts;
/*End code section*/"
        }
