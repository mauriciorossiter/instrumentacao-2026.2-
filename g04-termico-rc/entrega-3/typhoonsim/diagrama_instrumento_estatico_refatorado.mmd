%%{init: {
  "theme": "base",
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 34,
    "rankSpacing": 52,
    "htmlLabels": true
  },
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "primaryTextColor": "#172033",
    "lineColor": "#2453b3",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#6f83c5"
  }
}}%%

flowchart LR
    subgraph FONTE["FONTE / ENTRADA"]
        direction TB
        X["Fonte x(t)<br/>Grandeza medida<br/>Rampa periódica: 0 a 10"]
    end

    subgraph INSTRUMENTO["INSTRUMENTO GENÉRICO NÃO IDEAL"]
        direction LR
        GANHO["S<br/>Sensibilidade<br/>Ganho estático"]
        SOMA((Σ))
        OFFSET["b = 0,5<br/>Desvio de zero<br/>Offset na saída"]
        SENSIBILIDADE["S = 1,2<br/>Sensibilidade nominal"]
        YREAL["y_real<br/>Saída indicada"]

        GANHO -->|"S · x"| SOMA
        OFFSET -->|"+ b"| SOMA
        SOMA -->|"y_real = S · x + b"| YREAL
        SENSIBILIDADE --> GANHO
    end

    subgraph REFERENCIAS["CANAIS DE REFERÊNCIA PARA A ATIVIDADE"]
        direction TB
        YIDEAL["Saida_ideal<br/>y_ideal = x"]
        YZERO["Saida_desvio_zero<br/>y_zero = x + b"]
        YSENS["Saida_sensibilidade<br/>y_sens = S · x"]
    end

    subgraph SAIDAS["SAÍDAS / VISUALIZAÇÃO"]
        direction TB
        INDICACAO["Indicação do instrumento<br/>Saida_real"]
        ERRO["Erro_total<br/>e = y_real − y_ideal<br/>e = 0,5 + 0,2x"]
        SCADA["HIL SCADA / VHIL<br/>Scope com x e as quatro saídas"]
    end

    subgraph VALIDACAO["VALIDAÇÃO EXPERIMENTAL SOLICITADA NA DEVOLUTIVA"]
        direction TB
        AQUISICAO["Aquisição pela API do Typhoon<br/>dados_vhil.csv"]
        AJUSTE["Regressão da saída real<br/>y_real = p_estimado + K_estimado · x"]
        DELTAS["Comparação com a referência<br/>p0 = 0 e K0 = 1<br/>Δp = p_estimado − p0<br/>ΔK = K_estimado − K0"]
    end

    X -->|"x"| GANHO
    X --> YIDEAL
    X --> YZERO
    X --> YSENS

    YREAL --> INDICACAO
    YREAL --> ERRO
    YIDEAL --> ERRO

    X --> SCADA
    YIDEAL --> SCADA
    YZERO --> SCADA
    YSENS --> SCADA
    YREAL --> SCADA
    ERRO --> SCADA
    SCADA --> AQUISICAO
    AQUISICAO --> AJUSTE
    AJUSTE --> DELTAS

    PARAMETROS["PARÂMETROS DO MODELO<br/>p0 = 0 e K0 = 1 (referência ideal)<br/>b = 0,5 e S = 1,2 (instrumento real)<br/>Δp = 0,5 e ΔK = S − 1 = 0,2"]
    CARACTERISTICAS["CARACTERÍSTICAS ESTÁTICAS<br/>b altera o intercepto vertical.<br/>S altera a inclinação da curva de calibração.<br/>Neste modelo não há saturação física."]

    YZERO ~~~ PARAMETROS
    YSENS ~~~ CARACTERISTICAS

    classDef entrada fill:#eef3ff,stroke:#2453b3,stroke-width:2px,color:#172033;
    classDef instrumento fill:#f5f7ff,stroke:#2453b3,stroke-width:2px,color:#172033;
    classDef parametro fill:#fff1f1,stroke:#c83d3d,stroke-width:2px,color:#572020;
    classDef referencia fill:#f7f7f7,stroke:#667085,stroke-width:1.5px,color:#172033;
    classDef saida fill:#eff9ef,stroke:#3f7f42,stroke-width:2px,color:#17351a;
    classDef validacao fill:#fff8e8,stroke:#b7791f,stroke-width:2px,color:#4a2c00;
    classDef nota fill:#ffffff,stroke:#667085,stroke-width:1.5px,color:#172033;

    class X entrada;
    class GANHO,SOMA,YREAL instrumento;
    class OFFSET,SENSIBILIDADE parametro;
    class YIDEAL,YZERO,YSENS referencia;
    class INDICACAO,ERRO,SCADA saida;
    class AQUISICAO,AJUSTE,DELTAS validacao;
    class PARAMETROS,CARACTERISTICAS nota;

    style FONTE fill:#ffffff,stroke:#2453b3,stroke-width:1.5px
    style INSTRUMENTO fill:#ffffff,stroke:#6f83c5,stroke-width:2px,stroke-dasharray:6 4
    style REFERENCIAS fill:#ffffff,stroke:#667085,stroke-width:1.5px,stroke-dasharray:4 3
    style SAIDAS fill:#ffffff,stroke:#3f7f42,stroke-width:1.5px
    style VALIDACAO fill:#ffffff,stroke:#b7791f,stroke-width:1.5px,stroke-dasharray:6 4

    linkStyle 1,3 stroke:#c83d3d,stroke-width:2px
