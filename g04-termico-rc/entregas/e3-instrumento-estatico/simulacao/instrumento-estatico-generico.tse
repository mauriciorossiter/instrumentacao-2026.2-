version = 4.2

//
// Modelo didatico: caracteristicas estaticas de um instrumento generico
// Typhoon HIL Control Center 2026.2 - HIL404 Base 1
// Referencia ideal: p0 = 0 e K0 = 1.
// Modelo implementado: p = b = 0.5 e K = S = 1.2.
// Desvios relativos: Delta p = 0.5 e Delta K = 0.2.
// A validacao experimental e feita por executar_validacao_vhil.py.
//

model "instrumento_estatico_generico" {
    configuration {
        hil_device = "HIL404"
        hil_configuration_id = 6
        simulation_method = exact
        simulation_time_step = auto
        simulation_discret_scaling = 1.0
        dsp_timer_periods = 100e-6, 50e-3
        ss_calc_method = "systematic elimination"
        enb_pole_shift = True
        enb_gds_oversampling = True
        show_modes = False
        device_ao_limit_enable = False
        reset_analog_outputs_on_sim_stop = True
        reset_analog_outputs_on_sim_stop_mode = Offset values
        reset_digital_outputs_on_sim_stop = True
        vhil_adio_loopback = False
        dma_enable = False
        cpl_stb = False
        enb_dep_sw_detect = False
        code_section = "internal memory"
        data_section = "internal memory"
        sys_sp_rate_1 = 0.0001
        sys_sp_rate_2 = 0.05
        sys_real_type_precision = "default"
        user_real_type_precision = "default"
        sys_cpu_optimization = "high"
        user_cpu_optimization = "high"
        user_cpu_part_option = "default"
        matrix_based_reduction = True
        cpl_dynamics_analysis = False
        export_ss_to_pickle = False
        ground_scope_core = False
        dss_num_tol = 1e-15
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_term_var_location = "local"
        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 1e-4
        simulation_time = 12.0
        abs_tol = 1e-3
        rel_tol = 1e-3
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Constant" "Habilita rampa" {
            execution_rate = "0.001"
            value = "1"
        }
        [
            position = 7520, 8008
        ]

        component "core/C function" "Gerador de entrada" {
            arb_defs = "/*Begin code section*/
// Rampa periodica de 0 a 10 unidades, com inclinacao de 1 unidade/s.
const double TS_RAMP = 0.001;
const double TAXA_RAMP = 1.0;
const double X_MAX = 10.0;
/*End code section*/"
            execution_rate = "0.001"
            global_variables = "real x_state;"
            init_fnc = "/*Begin code section*/
x_state = 0.0;
/*End code section*/"
            input_terminals = "real enable;"
            input_terminals_dimensions = "inherit"
            input_terminals_feedthrough = "False"
            input_terminals_show_labels = "True"
            output_fnc = "/*Begin code section*/
// A saida usa somente o estado calculado no passo anterior.
x = x_state;
/*End code section*/"
            output_terminals = "real x;"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/
if (enable >= 0.5) {
    x_state += TAXA_RAMP * TS_RAMP;
    if (x_state >= X_MAX) {
        x_state -= X_MAX;
    }
} else {
    x_state = 0.0;
}
/*End code section*/"
        }
        [
            position = 7672, 7984
            size = 136, 64
        ]

        component "core/Constant" "Desvio de zero b" {
            execution_rate = "0.001"
            value = "0.5"
        }
        [
            position = 7840, 8080
        ]

        component "core/Constant" "Sensibilidade S" {
            execution_rate = "0.001"
            value = "1.2"
        }
        [
            position = 7840, 8136
        ]

        component "core/C function" "Instrumento estatico" {
            arb_defs = "/*Begin code section*/
// Caracteristica estatica ideal: y = x.
// Caracteristica estatica real:  y = b + S*x.
/*End code section*/"
            execution_rate = "0.001"
            input_terminals = "real x;real b;real sensibilidade;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "/*Begin code section*/
saida_ideal = x;
saida_desvio_zero = x + b;
saida_sensibilidade = sensibilidade * x;
saida_real = b + sensibilidade * x;
erro_total = saida_real - saida_ideal;
/*End code section*/"
            output_terminals = "real saida_ideal;real saida_desvio_zero;real saida_sensibilidade;real saida_real;real erro_total;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True"
        }
        [
            position = 8080, 7976
            size = 184, 136
        ]

        component "core/Probe" Entrada_x {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Entrada_x"
        }
        [
            position = 7928, 7912
        ]

        component "core/Probe" Saida_ideal {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Saida_ideal"
        }
        [
            position = 8408, 7976
        ]

        component "core/Probe" Saida_desvio_zero {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Saida_desvio_zero"
        }
        [
            position = 8408, 8024
        ]

        component "core/Probe" Saida_sensibilidade {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Saida_sensibilidade"
        }
        [
            position = 8408, 8072
        ]

        component "core/Probe" Saida_real {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Saida_real"
        }
        [
            position = 8408, 8120
        ]

        component "core/Probe" Erro_total {
            execution_rate = "0.001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "Erro_total"
        }
        [
            position = 8408, 8168
        ]

        connect "Habilita rampa.out" "Gerador de entrada.enable" as Connection1
        connect "Gerador de entrada.x" "Instrumento estatico.x" as Connection2
        connect "Gerador de entrada.x" Entrada_x.in as Connection3
        connect "Desvio de zero b.out" "Instrumento estatico.b" as Connection4
        connect "Sensibilidade S.out" "Instrumento estatico.sensibilidade" as Connection5
        connect "Instrumento estatico.saida_ideal" Saida_ideal.in as Connection6
        connect "Instrumento estatico.saida_desvio_zero" Saida_desvio_zero.in as Connection7
        connect "Instrumento estatico.saida_sensibilidade" Saida_sensibilidade.in as Connection8
        connect "Instrumento estatico.saida_real" Saida_real.in as Connection9
        connect "Instrumento estatico.erro_total" Erro_total.in as Connection10
    }

    default {
        "core/C function" {
            input_terminals = "real in;"
            input_terminals_show_labels = "False;"
            input_terminals_feedthrough = "True;"
            input_terminals_dimensions = "inherit;"
            output_terminals = "real out;"
            output_terminals_show_labels = "False;"
            output_terminals_feedthrough = "True;"
            output_terminals_dimensions = "inherit;"
            output_fnc = ""
            update_fnc = ""
            init_fnc = ""
            global_variables = ""
            parameters = ""
            library_load_type = "Compile-time load"
            dll_file_path = ""
            dll_file_path_full = ""
            arm_a9_file_path = ""
            arm_a9_file_path_full = ""
            arm_a53_file_path = ""
            arm_a53_file_path_full = ""
            h_file_path = ""
            h_file_path_full = ""
            add_src_path = ""
            add_src_path_full = ""
            convert_to_relative_dll = "True"
            convert_to_relative_a = "True"
            convert_to_relative_src = "True"
            arb_defs = ""
            add_macros = ""
            skip_pre_cmpl_check = "False"
            generate_for_hil = "True"
            execution_rate = "inherit"
            _supported_platforms = "[\'generic\']"
            refresh = "refresh"
        }

        "core/Constant" {
            value = "1"
            signal_type = "real"
            execution_rate = "100e-6"
            _tunable = "False"
        }

        "core/Probe" {
            signal_access = "inherit"
            addr = "0"
            override_signal_name = "False"
            signal_name = ""
            signal_type = "generic"
            streaming_en = "False"
            streaming_er_idx = "0"
            execution_rate = "inherit"
        }
    }
}
