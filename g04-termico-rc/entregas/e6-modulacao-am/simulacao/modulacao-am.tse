version = 4.2

// Equipe 04 - ECOM060, capitulo 5, secao 5.2: modulacao em amplitude.
// Execucao pretendida: TyphoonSim / Virtual HIL, HIL404 Base 1.
// Tres regimes ciclicos, cada um com 0.4 s: mu = 0.5, 1.0, 1.5.
// Frequencias: portadora 500 Hz, mensagem 25 Hz; taxa interna 10 kHz.
// Amostre por Capture, NAO por polling de read_analog_signals.

model "Equipe_04_ModulacaoAM" {
    configuration {
        hil_device = "HIL404"
        hil_configuration_id = 6
        simulation_method = exact
        simulation_time_step = auto
        simulation_discret_scaling = 1.0
        dsp_timer_periods = 100e-6, 50e-3
        ss_calc_method = "systematic elimination"
        enb_pole_shift = True
        enb_gds_oversampling = True
        show_modes = False
        device_ao_limit_enable = False
        reset_analog_outputs_on_sim_stop = True
        reset_analog_outputs_on_sim_stop_mode = Offset values
        reset_digital_outputs_on_sim_stop = True
        vhil_adio_loopback = False
        dma_enable = False
        cpl_stb = False
        enb_dep_sw_detect = False
        code_section = "internal memory"
        data_section = "internal memory"
        sys_sp_rate_1 = 0.0001
        sys_sp_rate_2 = 0.05
        sys_real_type_precision = "default"
        user_real_type_precision = "default"
        sys_cpu_optimization = "high"
        user_cpu_optimization = "high"
        user_cpu_part_option = "default"
        matrix_based_reduction = True
        cpl_dynamics_analysis = False
        export_ss_to_pickle = False
        ground_scope_core = False
        dss_num_tol = 1e-15
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_term_var_location = "local"
        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 1e-4
        simulation_time = 100.0
        abs_tol = 1e-3
        rel_tol = 1e-3
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Constant" "Habilita gerador" {
            execution_rate = "0.0001"
            value = "1"
        }
        [
            position = 7384, 8192
        ]

        component "core/C function" "Fontes e regimes AM" {
            execution_rate = "0.0001"
            global_variables = "int sample_count;"
            init_fnc = "/*Begin code section*/
sample_count = 0;
/*End code section*/"
            input_terminals = "real enable;"
            input_terminals_dimensions = "inherit"
            input_terminals_feedthrough = "False"
            input_terminals_show_labels = "True"
            output_fnc = "/*Begin code section*/
int in_segment = sample_count % 4000;
int regime = (sample_count / 4000) % 3;
double t_local = 0.0001 * (double)in_segment;
double pi_local = 3.14159265358979323846;
mensagem_norm = cos(2.0 * pi_local * 25.0 * t_local);
portadora = cos(2.0 * pi_local * 500.0 * t_local);
indice_modulacao = (regime == 0) ? 0.5 : ((regime == 1) ? 1.0 : 1.5);
/*End code section*/"
            output_terminals = "real mensagem_norm;real portadora;real indice_modulacao;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True"
            output_terminals_show_labels = "True;True;True"
            update_fnc = "/*Begin code section*/
if (enable >= 0.5) {
    sample_count += 1;
    if (sample_count >= 12000) sample_count = 0;
} else {
    sample_count = 0;
}
/*End code section*/"
        }
        [
            position = 7696, 8136
            size = 184, 104
        ]

        component "core/C function" "Modulador AM" {
            execution_rate = "0.0001"
            input_terminals = "real mensagem_norm;real portadora;real indice_modulacao;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "/*Begin code section*/
envoltoria_assinada = 1.0 + indice_modulacao * mensagem_norm;
sinal_am = envoltoria_assinada * portadora;
/*End code section*/"
            output_terminals = "real envoltoria_assinada;real sinal_am;"
            output_terminals_dimensions = "inherit;inherit"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
        }
        [
            position = 8096, 8136
            size = 176, 104
        ]

        component "core/Probe" Mensagem_norm {
            execution_rate = "0.0001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "mensagem_norm"
        }
        [
            position = 7912, 7992
        ]

        component "core/Probe" Portadora {
            execution_rate = "0.0001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "portadora"
        }
        [
            position = 7912, 8048
        ]

        component "core/Probe" Indice_modulacao {
            execution_rate = "0.0001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "indice_modulacao"
        }
        [
            position = 7912, 8272
        ]

        component "core/Probe" Envoltoria_assinada {
            execution_rate = "0.0001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "envoltoria_assinada"
        }
        [
            position = 8360, 8072
        ]

        component "core/Probe" Sinal_AM {
            execution_rate = "0.0001"
            override_signal_name = "True"
            signal_access = "Public"
            signal_name = "sinal_am"
        }
        [
            position = 8360, 8192
        ]

        connect "Habilita gerador.out" "Fontes e regimes AM.enable" as Connection1
        connect "Fontes e regimes AM.mensagem_norm" "Modulador AM.mensagem_norm" as Connection2
        connect "Fontes e regimes AM.portadora" "Modulador AM.portadora" as Connection3
        connect "Fontes e regimes AM.indice_modulacao" "Modulador AM.indice_modulacao" as Connection4
        connect "Fontes e regimes AM.mensagem_norm" Mensagem_norm.in as Connection5
        connect "Fontes e regimes AM.portadora" Portadora.in as Connection6
        connect "Fontes e regimes AM.indice_modulacao" Indice_modulacao.in as Connection7
        connect "Modulador AM.envoltoria_assinada" Envoltoria_assinada.in as Connection8
        connect "Modulador AM.sinal_am" Sinal_AM.in as Connection9
    }

    default {
        "core/C function" {
            input_terminals = "real in;"
            input_terminals_show_labels = "False;"
            input_terminals_feedthrough = "True;"
            input_terminals_dimensions = "inherit;"
            output_terminals = "real out;"
            output_terminals_show_labels = "False;"
            output_terminals_feedthrough = "True;"
            output_terminals_dimensions = "inherit;"
            output_fnc = ""
            update_fnc = ""
            init_fnc = ""
            global_variables = ""
            parameters = ""
            library_load_type = "Compile-time load"
            dll_file_path = ""
            dll_file_path_full = ""
            arm_a9_file_path = ""
            arm_a53_file_path = ""
            h_file_path = ""
            h_file_path_full = ""
            add_src_path = ""
            add_src_path_full = ""
            convert_to_relative_dll = "True"
            convert_to_relative_a = "True"
            convert_to_relative_src = "True"
            arb_defs = ""
            add_macros = ""
            skip_pre_cmpl_check = "False"
            generate_for_hil = "True"
            execution_rate = "inherit"
            _supported_platforms = "['generic']"
            refresh = "refresh"
        }

        "core/Constant" {
            value = "1"
            signal_type = "real"
            execution_rate = "100e-6"
            _tunable = "False"
        }

        "core/Probe" {
            signal_access = "inherit"
            addr = "0"
            override_signal_name = "False"
            signal_name = ""
            signal_type = "generic"
            streaming_en = "False"
            streaming_er_idx = "0"
            execution_rate = "inherit"
        }
    }
}
