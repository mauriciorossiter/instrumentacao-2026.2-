<ui_settings>
    <version>2.9</version>
    <model_locked>False</model_locked>
    <canvas_bg_color>#ffffff</canvas_bg_color>
    <initialization_code><![CDATA[# Painel G05 - Monotanque - Fase 2 / ENTREGA FINAL (ECOM060, UFAL 2026.2)
import time

PAD = {'dT_ar_C': 5.0, 'e0_mm': 5.0, 'ruido_mm': 2.0, 'T_amostra_s': 0.15, 'tau_sensor_s': 0.5, 't_lat_s': 0.14, 'resol_mm': 5.0, 'interf_mV': 10.0, 'adc_bits': 12.0, 'comp_termica': 0.0, 'cal_zero_mm': 0.0, 'tau_filtro_s': 1.0, 'R_terra_mOhm': 0.0, 'h_op_m': 0.5, 'dsp_m': 0.1, 'rampa_mm_s': 1.0, 'qd_degrau_Ls': 2.0, 'degrau_bomba_pct': 20.0, 'Kp_Ls_m': 46.93, 'Ti_s': 26.07, 'prefiltro': 1.0, 'ensaio': 1.0, 'malha': 1.0, 'realimentacao': 1.0, 'diferencial': 0.0, 'qd_Ls': 0.0}
COMBOS = {'ensaio': ['1 Degrau de referencia', '2 Degrau de consumo (perturbacao)', '3 Rampa de referencia'], 'malha': ['Malha ABERTA (bomba fixa)', 'Malha FECHADA (PI)'], 'realimentacao': ['Medicao IDEAL', 'Medicao REAL (sensor)'], 'diferencial': ['Entrada SIMPLES (0 V comum)', 'Entrada DIFERENCIAL (CMRR 60 dB)']}
SENSOR = {'dT_ar_C': 5.0, 'e0_mm': 5.0, 'ruido_mm': 2.0, 'T_amostra_s': 0.15, 'tau_sensor_s': 0.5, 't_lat_s': 0.14, 'resol_mm': 5.0, 'interf_mV': 10.0, 'adc_bits': 12.0}
PROC = {'comp_termica': 0.0, 'cal_zero_mm': 0.0, 'tau_filtro_s': 1.0}


def disparar():
    # borda de subida em 'disparo' zera o relogio; o evento do ensaio acontece em t_ev = 150 s
    hil.set_scada_input_value('disparo', 0.0)
    hil.set_scada_input_value('disparo', 1.0)
    time.sleep(0.1)
    hil.set_scada_input_value('disparo', 0.0)


def sincronizar(pnl, nome, valor):
    # atualiza o campo do painel com o valor aplicado (se a versao do SCADA permitir)
    try:
        w = pnl.get_widget_by_fqn('w_' + nome)
        if nome in COMBOS:
            pnl.set_property_value(w, 'widget_value', COMBOS[nome][int(round(valor))] if nome != 'ensaio'
                                   else COMBOS[nome][int(round(valor)) - 1])
        else:
            pnl.set_property_value(w, 'widget_value', str(valor))
    except Exception:
        pass


def ajustar(valores, pnl=None):
    for k, v in valores.items():
        hil.set_scada_input_value(k, float(v))
        if pnl is not None:
            sincronizar(pnl, k, v)


def cenario(extra, pnl=None):
    v = dict(PAD)
    v.update(extra)
    ajustar(v, pnl)
    disparar()
]]></initialization_code>
