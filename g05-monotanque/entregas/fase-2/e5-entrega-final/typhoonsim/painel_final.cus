                    <height>360</height>
                    <appearance><![CDATA[Flat]]></appearance>
                    <hierarchy_position><![CDATA[1]]></hierarchy_position>
                    <is_background><![CDATA[False]]></is_background>
                    <label><![CDATA[Referencia x nivel MEDIDO x nivel REAL da planta [m]]]></label>
                    <use_label>True</use_label>
                </widget_settings>
                <advance_widget_settings>
                    <x_title><![CDATA[x axes]]></x_title>
                    <y_title><![CDATA[nivel [m]]]></y_title>
                    <y_range_min>-100</y_range_min>
                    <y_range_max>100</y_range_max>
