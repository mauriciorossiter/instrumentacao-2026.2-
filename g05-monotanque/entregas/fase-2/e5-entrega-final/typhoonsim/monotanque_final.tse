    CODE model_init
        # =====================================================================
        #  ECOM060 - Instrumentacao Eletronica - UFAL - 2026.2 - Equipe G05 (Monotanque)
        #  Fase 2 / ENTREGA FINAL: instrumentacao nao ideal e seus efeitos no controle
        #  Planta (E02 v2):  A dh/dt = qi - q - qd ;  I_h dq/dt = h - q|q|/k^2
        #  Sensor: ultrassonico de tempo de voo MaxBotix MB7389 (HRXL-MaxSonar-WRM), montado no topo
        # =====================================================================
        # ---- planta (Entrega 01 / 02)
        A      = 0.5            # m2       area da base
        l_tubo = 1.0            # m        comprimento do tubo de saida
        k_nom  = 0.01           # m^2.5/s  coeficiente do orificio
        h0     = 0.5            # m        nivel de operacao
        g      = 9.81
        Cd     = 0.60
        a_or   = k_nom/(Cd*(2*g)**0.5)
        I_h    = l_tubo/(g*a_or)
        
        # ---- escalas (1 V = 10 cm ; 1 A = 1 L/s ; 1 s no circuito = 100 s no tanque)
        kv = 10.0
        ki = 1000.0
        kt = 100.0
        
        C     = A*ki/(kv*kt)
        L     = kv*I_h/(ki*kt)
        K_e   = k_nom*ki/kv**0.5
        V0    = kv*h0
        I0    = ki*k_nom*h0**0.5
        R_or  = 2*V0**0.5/K_e
        w_c   = 1/(R_or*C)
        Ts    = 2e-5            # s (circuito) = 2 ms no tanque
        
        # ---- sensor MB7389 (datasheet MaxBotix HRXL-MaxSonar-WR, PD11500)
        H_s    = 1.70           # m   altura da face do sensor sobre o fundo (h = 1,2 m -> d = 0,5 m)
        T_amb  = 25.0           # C   temperatura do ar no sensor (compensacao interna)
        k_s    = 5.0/5.120      # V/m saida analogica Vcc/5120 por mm, Vcc = 5 V (0,9766 V/m)
        d0     = H_s - h0       # m   distancia no ponto de operacao (1,20 m)
        N_MAX_ATRASO = 16000    # amostras de Ts (= 32 s no tanque)
        
        # ---- condicionamento
        R_f    = 1.6e3          # ohm  filtro RC anti-serrilhado
        C_f    = 10e-6/kt       # F    10 uF real -> tau = 16 ms (real) ; escalonado no tempo
        V_off  = 0.45           # V    deslocamento do amplificador (d = 0,46 m)
        G_amp  = 2.8            # V/V  ganho: 0,49..1,56 V -> 0,1..3,1 V
        V_ref  = 3.3            # V    fundo de escala do ADC
        f_adc  = 100.0          # Hz   taxa do ADC (tempo real) -> periodo 0,01 s no tanque
        e_Text = 0.5            # C    erro do sensor externo de temperatura (estimativa)
        
        # ---- laco de terra e entrada diferencial (entrega final)
        alfa_bomba = 2.0        # A/(L/s)  corrente do motor CC 24 V da bomba por vazao (estimativa: ~14 A em q0 = 7,07 L/s)
        CMRR_dB    = 60.0       # dB       rejeicao de modo comum efetiva do amplificador diferencial (estimativa conservadora)
        rej_cm     = 10**(-CMRR_dB/20)
        
        # ---- ensaios
        t_ev  = 1.5            # s (circuito): instante do evento (150 s no tanque)
        Kp_prep = 50.0
        Q_MAX = 20.0            # A = L/s  vazao maxima da bomba
        
        # ---- controlador PI (alocacao de polos: wn = 0,06 rad/s, zeta = 0,9 ; previsao no relatorio)
        R_hid = 2*h0**0.5/k_nom          # s/m2  ganho local (141,4)
        tau_p = A*R_hid                  # s     constante de tempo (70,7)
        wn    = 0.06
        zeta  = 0.9
        Kp_m  = (2*zeta*wn*tau_p - 1)/R_hid       # m2/s
        Kp_d  = Kp_m*ki                           # (L/s)/m   = 46,9
        Ti_d  = R_hid*Kp_m/(tau_p*wn**2)          # s (tanque) = 26,1
    ENDCODE
}
