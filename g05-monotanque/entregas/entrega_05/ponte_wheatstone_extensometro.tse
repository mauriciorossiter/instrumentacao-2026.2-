    CODE model_init
        # =====================================================================
        #  ECOM060 - Instrumentacao Eletronica - UFAL - 2026.2
        #  Fase 1 / Entrega 01 - Equipe G05
        #  Extensometro (7.1.3) em ponte de Wheatstone de 1/4 (6.1)
        #
        #  Extensometro: OMEGA SGD-3/350-LY11 (folha de constantan)
        #     R0 = 350 ohm, GF = 2,0
        #  Excitacao: 5 V CC (limite do datasheet: 9,5 Vrms)
        #  Especificacao (R2): S >= 0,5 (mV/V)/mstrain
        #
        #  O extensometro e modelado como R0 em serie com uma fonte de tensao
        #  controlada v = dR*i, com dR = R0*GF*eps. Eletricamente equivale a uma
        #  resistencia R0 + dR; a ponte (R1, R3, R4, Vex) e resolvida pelo solver.
        # =====================================================================
        Ts      = 1e-4        # s   - passo dos blocos de sinal
        R0      = 350.0       # ohm - resistencia nominal do extensometro
        GF      = 2.0         # gauge factor
        Vex     = 5.0         # V   - excitacao da ponte
        eps_max = 2000e-6     # 2000 microstrain (faixa nominal)
        f_sweep = 0.5         # Hz  - varredura triangular 0 -> eps_max -> 0 em 2 s
    ENDCODE
}
