    CODE model_init
        # =====================================================================
        #  ECOM060 - Instrumentacao Eletronica - UFAL - 2026.2
        #  Fase 1 / Entrega 02 - Equipe G05 - Nao idealidades
        #  Extensometro OMEGA SGD-3/350-LY11 em ponte de Wheatstone de 1/4
        #  (mesma ponte da Entrega 01: R1 = R3 = R4 = R0, Vex = 5 V)
        # =====================================================================
        Ts      = 1e-4        # s   - passo dos blocos de sinal
        R0      = 350.0       # ohm - resistencia nominal
        GF      = 2.0         # gauge factor nominal
        Vex     = 5.0         # V   - excitacao da ponte
        eps_max = 2000e-6     # fundo de escala (2000 microstrain)
        f_sweep = 0.5         # Hz  - varredura triangular 0 -> eps_max -> 0 em 2 s
        
        # ---- camada estatica (Cap. 3) - OMEGA Strain Gage Technical Data
        T_ref    = 23.0       # C   - temperatura de referencia do datasheet
        T_op     = 53.0       # C   - temperatura do ensaio
        dT       = T_op - T_ref
        tol_GF   = -0.01      # tolerancia do GF por lote: +-1,00 % (pior caso, abaixo)
        alpha_GF = 1.0e-4     # 1/K - variacao do GF com T: < 1 % em 100 C
        beta_TO  = 2.0e-6     # 1/K - tolerancia da compensacao de temperatura: 2 ppm/C
        GF_real  = GF*(1 + tol_GF)*(1 + alpha_GF*dT)   # sensibilidade real
        eps_app  = beta_TO*dT                           # deformacao aparente (desvio de zero)
        
        # ---- camada dinamica (Cap. 4)
        K_din    = 1.0        # ordem zero: e(t) = K*eps(t), sem atraso
        eps_step = 1000e-6    # degrau de 1000 microstrain
        t_step   = 0.5        # s
        
        # ---- camada espectral (Cap. 5) - ruido termico (Johnson) da ponte
        kB      = 1.380649e-23
        T_K     = T_op + 273.15
        R_out   = R0          # resistencia de saida da ponte: R1//Rg + R3//R4 = R0
        B_n     = 1/(2*Ts)    # banda do ruido amostrado a 1/Ts
        sigma_n = (4*kB*T_K*R_out*B_n)**0.5   # V rms na saida
    ENDCODE
}
