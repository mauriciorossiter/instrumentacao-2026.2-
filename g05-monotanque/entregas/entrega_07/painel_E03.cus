<ui_settings>
    <version>2.9</version>
    <model_locked>False</model_locked>
    <canvas_bg_color>#ffffff</canvas_bg_color>
    <initialization_code><![CDATA[# Painel da Entrega 03 - Equipe G05 (ECOM060, UFAL 2026.2)
# Funcoes comuns a todas as macros.
import time

ENSAIOS = ['Varredura E01 (R2)', '(a) Degrau', '(b) Condicao inicial', '(c) Pulso']


def disparar():
    # borda de subida em 'disparo' zera o relogio do ensaio no modelo
    hil.set_scada_input_value('disparo', 0.0)
    hil.set_scada_input_value('disparo', 1.0)
    time.sleep(0.1)
    hil.set_scada_input_value('disparo', 0.0)
]]></initialization_code>
