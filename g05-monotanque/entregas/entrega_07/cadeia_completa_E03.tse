    CODE model_init
        # =====================================================================
        #  ECOM060 - Instrumentacao Eletronica - UFAL - 2026.2
        #  Fase 1 / Entrega 03 - Equipe G05 - Validacao funcional
        #  Cadeia completa: extensometro OMEGA SGD-3/350-LY11 com as tres camadas
        #  da Entrega 02 + ponte de Wheatstone de 1/4 da Entrega 01
        # =====================================================================
        Ts      = 1e-4        # s   - passo dos blocos de sinal
        R0      = 350.0       # ohm - resistencia nominal
        GF      = 2.0         # gauge factor nominal
        Vex     = 5.0         # V   - excitacao da ponte
        eps_max = 2000e-6     # fundo de escala (2000 microstrain)
        f_sweep = 0.5         # Hz  - varredura triangular da Entrega 01 (0 -> eps_max -> 0 em 2 s)
        
        # ---- ensaios-padrao (R11): instante do evento no relogio do ensaio
        t_ev    = 1.0         # s   - degrau / liberacao da condicao inicial / inicio do pulso
        
        # ---- camada estatica (Cap. 3) - OMEGA Strain Gage Technical Data
        T_ref    = 23.0       # C   - temperatura de referencia do datasheet
        tol_GF   = -0.01      # tolerancia do GF por lote: -1 % (pior caso)
        alpha_GF = 1.0e-4     # 1/K - variacao do GF com a temperatura
        beta_TO  = 2.0e-6     # 1/K - tolerancia da compensacao de temperatura (2 ppm/C)
        # T_op (temperatura do ensaio) e ajustada no SCADA; padrao 53 C
        
        # ---- camada dinamica (Cap. 4)
        K_din    = 1.0        # ordem zero: e(t) = K*eps(t), sem atraso
        
        # ---- camada espectral (Cap. 5) - ruido termico (Johnson) da ponte, a 53 C
        kB      = 1.380649e-23
        T_K     = 53.0 + 273.15
        R_out   = R0          # resistencia de saida da ponte = R0
        B_n     = 1/(2*Ts)    # banda do ruido amostrado a 1/Ts
        sigma_n = (4*kB*T_K*R_out*B_n)**0.5   # V rms na saida (~0,18 uV)
        
        # ---- conversao de e0 para deformacao lida (sensibilidade linear GF/4)
        k_eps   = 4/(Vex*GF)*1e6                # V -> microstrain
    ENDCODE
}
