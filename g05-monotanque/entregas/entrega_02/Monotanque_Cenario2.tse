            position = 8544, 8384
        ]

        junction Jt_out pe
        [
            position = 8768, 8192
        ]

        junction Jb_out pe
        [
            position = 8768, 8384
        ]

        junction Jt_vc pe
        [
            position = 8992, 8192
        ]

        junction Jb_vc pe
        [
            position = 8992, 8384
        ]

        junction Jq_o sp
        [
            position = 8688, 8032
        ]

        junction Jq_i sp
        [
            position = 8192, 8032
        ]

        comment Nota START <!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd"><html><head><meta name="qrichtext" content="1" /><style type="text/css">p, li { white-space: pre-wrap; }</style></head><body style=" font-family:'Arial'; font-size:10pt; font-weight:400; font-style:normal;"><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">MONOTANQUE - ECOM060 (UFAL 2026.2) - Cenario 2: Drenagem livre (validacao: t_vazio ~ 89.44 s)</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;"><br /></p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">A*dh/dt = q_i(t) - k*sqrt(h)   &lt;-&gt;   C*dv_C/dt = i_in(t) - k*sqrt(v_C)</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">C = A = 0.5 F   k = 0.01   q_i0 = k*sqrt(h0) = 0.0070711 A</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">v_C(0) = 0.8 V   T_stop = 95 s   Ts = 0.01 s</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;"><br /></p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">v_C [V] = nivel h [m] ; i_in [A] = q_i [m3/s] ; i_out [A] = q_o [m3/s]</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Dreno nao linear (Torricelli): VC -&gt; Limit(&gt;=0) -&gt; sqrt -&gt; Gain(k) -&gt; Iout_dreno</p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;"><br /></p><p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">VALIDACAO: sqrt(h(t)) = sqrt(0.80) - (k/2A)*t  =&gt;  t_vazio = 2*A*sqrt(0.80)/k = 89.4427 s</p></body></html> ENDCOMMENT 
        [
            position = 8320, 8560
        ]

        connect Iin_qi.p_node Jt_in as w_iin_tanque
        connect C_tanque.p_node Jt_c as w_cap_tanque
        connect Iout_dreno.n_node Jt_out as w_iout_tanque
        connect VC.p_node Jt_vc as w_vc_tanque
        connect Jt_in Jt_c as w_trilho_sup_1
        connect Jt_c Jt_out as w_trilho_sup_2
        connect Jt_out Jt_vc as w_trilho_sup_3
        connect Iin_qi.n_node Jb_in as w_iin_gnd
        connect C_tanque.n_node Jb_c as w_cap_gnd
        connect Iout_dreno.p_node Jb_out as w_iout_gnd
        connect VC.n_node Jb_vc as w_vc_gnd
        connect Jb_in Jb_c as w_trilho_inf_1
        connect Jb_c Jb_out as w_trilho_inf_2
        connect Jb_out Jb_vc as w_trilho_inf_3
        connect GND.node Jb_c as w_terra
        connect VC.out clamp_pos.in as w_vc_clamp
        connect clamp_pos.out raiz_vC.in as w_clamp_raiz
        connect raiz_vC.out ganho_k.in as w_raiz_ganho
        connect ganho_k.out Jq_o as w_ganho_jqo
        connect Jq_o Iout_dreno.in as w_jqo_iout
        connect Jq_o q_o.in as w_jqo_probe
        connect qi_in.out Jq_i as w_qi_jqi
        connect Jq_i Iin_qi.in as w_jqi_iin
        connect Jq_i q_i.in as w_jqi_probe
    }

    default {
