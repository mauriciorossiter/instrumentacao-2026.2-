        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 0.01
        simulation_time = 95
        abs_tol = 1e-6
        rel_tol = 1e-6
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.2
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Signal Controlled Current Source" Iin_qi {
            execution_rate = "Ts"
        }
        [
            position = 8320, 8288
            rotation = right
        ]

        component "core/Capacitor" C_tanque {
            capacitance = "0.5"
            initial_voltage = "0.8"
        }
        [
            position = 8544, 8288
            rotation = right
        ]

        component "core/Signal Controlled Current Source" Iout_dreno {
            execution_rate = "Ts"
        }
        [
            position = 8768, 8288
            rotation = left
        ]

        component "core/Voltage Measurement" VC {
            execution_rate = "Ts"
            sig_output = "True"
        }
        [
            position = 8992, 8288
            rotation = right
        ]

        component "core/Ground" GND {
        }
        [
            position = 8544, 8432
        ]

        component "core/Limit" clamp_pos {
            execution_rate = "Ts"
            lower_limit = "0"
        }
        [
            position = 9184, 8032
            scale = -1, 1
        ]

        component "core/Mathematical function" raiz_vC {
            execution_rate = "Ts"
            mathematical_fn = "sqrt"
        }
        [
            position = 9008, 8032
            scale = -1, 1
        ]

        component "core/Gain" ganho_k {
            execution_rate = "Ts"
            gain = "0.01"
        }
        [
            position = 8832, 8032
            scale = -1, 1
        ]

        component "core/Probe" q_o {
            execution_rate = "Ts"
        }
        [
            position = 8688, 7936
        ]

        component "core/Probe" q_i {
            execution_rate = "Ts"
        }
        [
            position = 8192, 7936
        ]

        component "core/Constant" qi_in {
            execution_rate = "Ts"
            value = "0"
        }
        [
            position = 7968, 8032
        ]

        component "core/Scope" Scope1 {
            selected_signals = "[\'VC\', \'q_i\', \'q_o\']"
            signals_data = "{\"plot_settings\": {\"layout\": \"Vertical\", \"background_color\": \"white\", \"legend_visible\": true, \"signals_tooltips_enabled\": true}, \"signals\": {\"VC\": {\"viewports\": [1], \"type\": \"analog\", \"color\": {\"1\": \"#FF0000\"}, \"display\": {\"1\": \"solid\"}, \"is_manual\": {\"1\": false}}, \"q_i\": {\"viewports\": [2], \"type\": \"analog\", \"color\": {\"2\": \"#0000FF\"}, \"display\": {\"2\": \"solid\"}, \"is_manual\": {\"2\": false}}, \"q_o\": {\"viewports\": [3], \"type\": \"analog\", \"color\": {\"3\": \"#008000\"}, \"display\": {\"3\": \"solid\"}, \"is_manual\": {\"3\": false}}}, \"viewports\": {\"1\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"2\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"3\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"4\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"5\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"6\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}}}"
            user_range_data = "{\"1\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}, \"2\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}, \"3\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}, \"4\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}, \"5\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}, \"6\": {\"user_x_range_mode\": \"Zoom to fit\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0, 1], \"user_y_range\": [0, 1]}}"
        }
        [
            position = 7488, 8288
        ]

        junction Jt_in pe
        [
            position = 8320, 8192
        ]

        junction Jb_in pe
        [
            position = 8320, 8384
        ]

        junction Jt_c pe
        [
            position = 8544, 8192
