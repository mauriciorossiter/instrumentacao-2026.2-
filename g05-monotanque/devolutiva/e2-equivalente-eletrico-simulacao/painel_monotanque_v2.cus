<ui_settings>
    <version>2.9</version>
    <model_locked>False</model_locked>
    <canvas_bg_color>#ffffff</canvas_bg_color>
    <initialization_code><![CDATA[# Painel do equivalente eletrico v2 - Equipe G05 (ECOM060, UFAL 2026.2)
import time

ENSAIOS = ['(a) Degrau na bomba a partir de h_op', '(b) De h(0) volta a h_op, bomba ligada',
           '(b) Drenagem livre a partir de h(0)', '(c) Senoide na bomba em h_op']
MODELOS = ['Nao linear: q = k*sqrt(h)', 'Linearizado em h_op: so o resistor R']


def disparar():
    # borda de subida em 'disparo' zera o relogio: ate t = 100 s (1 s no circuito) a bomba leva o nivel
    # ao valor inicial; ai o ensaio comeca
    hil.set_scada_input_value('disparo', 0.0)
    hil.set_scada_input_value('disparo', 1.0)
    time.sleep(0.1)
    hil.set_scada_input_value('disparo', 0.0)
]]></initialization_code>
    <components>
        <component_data>
                <id>6b010056e1ee11f19633010101010000</id>
                <name><![CDATA[Titulo]]></name>
                <type>TextNote</type>
                <description><![CDATA[]]></description>
                <text><![CDATA[G05 - Equivalente eletrico v2 do Monotanque (devolutiva da E02): bomba -> C (tanque) -> L (inercia) + R (escoamento) + e (parte nao linear)]]></text>
                <widget_settings>
                    <x>16</x>
                    <y>8</y>
                    <width>1560</width>
                    <height>32</height>
                    <background_color><![CDATA[None]]></background_color>
