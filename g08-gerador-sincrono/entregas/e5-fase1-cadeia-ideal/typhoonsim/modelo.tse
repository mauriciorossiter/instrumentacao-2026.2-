            gain = "1e6"
        }
        [
            position = 8620, 8300
        ]

        component "core/Gain" A_para_mA {
            gain = "1000"
        }
        [
            position = 9240, 8300
        ]

        component "core/Probe" theta_ref {
        }
        [
            position = 7960, 7700
        ]

        component "core/Probe" v_cursor {
        }
        [
            position = 8160, 7760
        ]

        component "core/Probe" I_IN_uA {
        }
        [
            position = 8760, 8300
        ]

        component "core/Probe" I_LOOP_mA {
        }
        [
