        ]

        component "core/Voltage Measurement" V_TX {
            execution_rate = "0.001"
            sig_output = "True"
        }
        [
            position = 9000, 8160
            rotation = right
        ]

        component "core/Resistor" R_cabo {
            resistance = "50.0"
        }
        [
            position = 9100, 8280
            rotation = right
        ]

        component "core/Current Measurement" I_LOOP {
            execution_rate = "0.001"
