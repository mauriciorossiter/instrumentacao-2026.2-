        [
            position = 9360, 8560
        ]

        connect VREF_XTR115.p_node no_VREF as Connection1
        connect no_VREF no_VREF2 as Connection2
        connect no_VREF2 no_VREF3 as Connection3
        connect R_pot.p_node no_VREF2 as Connection4
        connect V_REF.p_node no_VREF3 as Connection5
        connect no_VREF3 R0.p_node as Connection6
        connect R0.n_node no_IIN as Connection7
        connect buffer_OPA333.p_node no_cursor as Connection8
        connect no_cursor R_IN.p_node as Connection9
        connect R_IN.n_node no_IIN2 as Connection10
        connect no_IIN no_IIN2 as Connection11
        connect no_IIN2 I_IN.p_node as Connection12
        connect VREF_XTR115.n_node no_IRET as Connection13
        connect R_pot.n_node no_IRET as Connection14
        connect V_REF.n_node no_IRET as Connection15
        connect buffer_OPA333.n_node no_IRET as Connection16
        connect I_IN.n_node no_IRET as Connection17
        connect gnd_IRET.node no_IRET as Connection18
        connect V_LOOP.p_node no_V+2 as Connection19
        connect no_V+2 no_V+ as Connection20
        connect no_V+ no_V+3 as Connection21
        connect XTR115_Io.n_node no_V+ as Connection22
        connect XTR115_Io.p_node no_IO as Connection23
        connect V_TX.p_node no_V+3 as Connection24
        connect V_TX.n_node no_IO2 as Connection25
        connect no_IO no_IO2 as Connection26
        connect no_IO2 R_cabo.p_node as Connection27
        connect R_cabo.n_node I_LOOP.p_node as Connection28
        connect I_LOOP.n_node no_RX as Connection29
        connect no_RX no_RX2 as Connection30
        connect no_RX R_L.p_node as Connection31
        connect no_RX2 V_RL.p_node as Connection32
        connect V_LOOP.n_node no_GND as Connection33
        connect no_GND no_GND2 as Connection34
        connect no_GND2 no_GND3 as Connection35
        connect R_L.n_node no_GND2 as Connection36
        connect V_RL.n_node no_GND3 as Connection37
        connect gnd_laco.node no_GND as Connection38
        connect relogio.out referencia.t as Connection39
        connect referencia.theta_ref potenciometro.theta as Connection40
        connect V_REF.out potenciometro.vref as Connection41
        connect potenciometro.v_cursor buffer_OPA333.in as Connection42
        connect I_IN.out XTR115_x100.in as Connection43
        connect XTR115_x100.out XTR115_Io.in as Connection44
        connect V_RL.out receptor.v_rl as Connection45
        connect referencia.theta_ref receptor.theta_ref as Connection46
        connect referencia.theta_ref theta_ref.in as Connection47
        connect potenciometro.v_cursor v_cursor.in as Connection48
        connect I_IN.out A_para_uA.in as Connection49
        connect A_para_uA.out I_IN_uA.in as Connection50
        connect I_LOOP.out A_para_mA.in as Connection51
        connect A_para_mA.out I_LOOP_mA.in as Connection52
        connect V_TX.out V_TX_V.in as Connection53
        connect V_RL.out V_RL_V.in as Connection54
        connect receptor.theta_med theta_med.in as Connection55
        connect receptor.erro_FE erro_FE_pc.in as Connection56
        connect receptor.i_mA I_receptor_mA.in as Connection57
    }

    default {
        "core/C function" {
            input_terminals = "real in;"
