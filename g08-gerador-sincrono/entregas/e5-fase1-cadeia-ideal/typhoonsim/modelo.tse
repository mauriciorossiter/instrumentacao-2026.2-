version = 4.2

//
// Saved by sw version: 2026.2
//

model "modelo_tmp" {
    configuration {
        hil_device = "HIL101"
        hil_configuration_id = 1
        simulation_method = exact
        simulation_time_step = auto
        simulation_discret_scaling = 1.0
        dsp_timer_periods = 100e-6, 50e-3
        ss_calc_method = "systematic elimination"
        enb_pole_shift = True
        enb_gds_oversampling = True
        show_modes = False
        device_ao_limit_enable = False
        reset_analog_outputs_on_sim_stop = True
        reset_analog_outputs_on_sim_stop_mode = Offset values
        reset_digital_outputs_on_sim_stop = True
        vhil_adio_loopback = False
        dma_enable = False
        cpl_stb = False
        enb_dep_sw_detect = False
        code_section = "internal memory"
        data_section = "internal memory"
        sys_sp_rate_1 = 0.0001
        sys_sp_rate_2 = 0.05
        sys_real_type_precision = "default"
        user_real_type_precision = "default"
        sys_cpu_optimization = "high"
        user_cpu_optimization = "high"
        user_cpu_part_option = "default"
        matrix_based_reduction = True
        cpl_dynamics_analysis = False
        export_ss_to_pickle = False
        ground_scope_core = False
        dss_num_tol = 1e-15
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_term_var_location = "local"
        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 0.001
        simulation_time = 20.0
        abs_tol = 1e-9
        rel_tol = 1e-9
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Clock" relogio {
            execution_rate = "0.001"
        }
        [
            position = 7600, 7800
        ]

        component "core/C function" referencia {
            global_variables = "real THETA_FS;real T_MEIO;"
            init_fnc = "THETA_FS = 3600.0;
T_MEIO = 10.0000;"
            input_terminals = "real t;"
            input_terminals_dimensions = "inherit"
            input_terminals_show_labels = "True;"
            output_fnc = "/*Begin code section*/
/* Sinal de referencia (R2): varredura triangular 0 -> THETA_FS -> 0 graus */
if (t <= T_MEIO) {
    theta_ref = THETA_FS * t / T_MEIO;
} else {
    theta_ref = THETA_FS * (2.0 * T_MEIO - t) / T_MEIO;
}
if (theta_ref < 0.0) theta_ref = 0.0;
if (theta_ref > THETA_FS) theta_ref = THETA_FS;
/*End code section*/"
            output_terminals = "real theta_ref;"
            output_terminals_dimensions = "inherit"
            output_terminals_show_labels = "True;"
        }
        [
            position = 7760, 7800
        ]

        component "core/C function" potenciometro {
            global_variables = "real THETA_FS;real x;"
            init_fnc = "THETA_FS = 3600.0;
x = 0.0;"
            input_terminals = "real theta;real vref;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True;"
            input_terminals_show_labels = "True;True;"
            output_fnc = "/*Begin code section*/
/* Potenciometro IDEAL (Entrega 01): divisor razao-metrico sem carga
   (o cursor alimenta o buffer OPA333, impedancia de entrada ~infinita).
   x = theta / THETA_FS ;  v_cursor = x * V(VREF)
   As camadas nao ideais da Entrega 02 (resolucao, histerese, ruido de
   contato) entram aqui, sobre x. */
x = theta / THETA_FS;
if (x < 0.0) x = 0.0;
if (x > 1.0) x = 1.0;
v_cursor = x * vref;
/*End code section*/"
            output_terminals = "real v_cursor;"
            output_terminals_dimensions = "inherit"
            output_terminals_show_labels = "True;"
        }
        [
            position = 7960, 7840
        ]

        component "core/C function" receptor {
            global_variables = "real THETA_FS;real R_L;"
            init_fnc = "THETA_FS = 3600.0;
R_L = 250.000;"
            input_terminals = "real v_rl;real theta_ref;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True;"
            input_terminals_show_labels = "True;True;"
            output_fnc = "/*Begin code section*/
/* Receptor: le a tensao sobre R_L e converte em corrente e em angulo */
i_mA = 1000.0 * v_rl / R_L;
theta_med = THETA_FS * (i_mA - 4.0) / 16.0;
/* erro da corrente medida contra a reta ideal 4-20 mA, em % do fundo de escala */
erro_FE = 100.0 * (i_mA - (4.0 + 16.0 * theta_ref / THETA_FS)) / 16.0;
/*End code section*/"
            output_terminals = "real i_mA;real theta_med;real erro_FE;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;"
            output_terminals_show_labels = "True;True;True;"
        }
        [
            position = 9560, 8200
        ]

        component "core/Voltage Source" VREF_XTR115 {
            init_const_value = "2.5"
        }
        [
            position = 7960, 8160
            rotation = right
        ]

        component "core/Resistor" R_pot {
            resistance = "10000.0"
        }
        [
            position = 8080, 8160
            rotation = right
        ]

        component "core/Voltage Measurement" V_REF {
            execution_rate = "0.001"
            sig_output = "True"
        }
        [
            position = 8180, 8160
            rotation = right
        ]

        component "core/Resistor" R0 {
            resistance = "62600.0"
        }
        [
            position = 8340, 8040
        ]

        component "core/Signal Controlled Voltage Source" buffer_OPA333 {
        }
        [
            position = 8200, 8340
            rotation = right
        ]

        component "core/Resistor" R_IN {
            resistance = "15600.0"
        }
        [
            position = 8340, 8240
        ]

