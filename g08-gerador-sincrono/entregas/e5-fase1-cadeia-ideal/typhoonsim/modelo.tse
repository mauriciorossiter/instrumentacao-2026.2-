        ]

        component "core/Scope" Scope_cadeia {
            selected_signals = "[\'theta_ref\', \'theta_med\', \'I_LOOP_mA\', \'V_RL_V\', \'V_TX_V\', \'I_IN_uA\', \'v_cursor\', \'erro_FE_pc\', \'I_receptor_mA\']"
        }
        [
