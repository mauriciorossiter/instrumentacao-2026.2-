        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 0.001
        simulation_time = 20.0
        abs_tol = 1e-9
        rel_tol = 1e-9
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
