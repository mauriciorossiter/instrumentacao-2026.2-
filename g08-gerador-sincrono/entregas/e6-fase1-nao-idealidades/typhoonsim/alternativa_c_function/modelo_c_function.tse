    component Subsystem Root {
        component "core/Clock" relogio {
            execution_rate = "0.001"
        }
        [
            position = 7600, 7800
        ]

        component "core/C function" referencia {
            global_variables = "real THETA_FS;real T_MEIO;"
            init_fnc = "THETA_FS = 3600.0;
T_MEIO = 10.0000;"
            input_terminals = "real t;"
            input_terminals_dimensions = "inherit"
            input_terminals_show_labels = "True;"
            output_fnc = "/*Begin code section*/
/* Sinal de referencia (R2): varredura triangular 0 -> THETA_FS -> 0 graus */
if (t <= T_MEIO) {
    theta_ref = THETA_FS * t / T_MEIO;
} else {
    theta_ref = THETA_FS * (2.0 * T_MEIO - t) / T_MEIO;
}
if (theta_ref < 0.0) theta_ref = 0.0;
if (theta_ref > THETA_FS) theta_ref = THETA_FS;
/*End code section*/"
            output_terminals = "real theta_ref;"
            output_terminals_dimensions = "inherit"
            output_terminals_show_labels = "True;"
        }
        [
            position = 7760, 7800
        ]

        component "core/C function" potenciometro {
            global_variables = "real THETA_FS;real FOLGA;real N_PASSOS;real FASE;real K_ENR;real I_CURSOR;real CAM_FOLGA;real CAM_RES;real CAM_RUIDO;real primeiro;real th_c;real th_min;real th_out;real th_ant;real movendo;real x;real s_lcg;real g;real w;real rosa;int k;real b0;real b1;real b2;real b3;real b4;real b5;real b6;"
            init_fnc = "THETA_FS = 3600.0;
FOLGA = 1.000000;
N_PASSOS = 5000.0;
FASE = 0.250000;
K_ENR = 9.2681240002495215;
I_CURSOR = 2.000000e-10;
CAM_FOLGA = 1.0;
CAM_RES = 1.0;
CAM_RUIDO = 1.0;
primeiro = 1.0; th_c = 0.0; th_min = 0.0; th_out = 0.0; th_ant = 0.0; movendo = 0.0; x = 0.0;
s_lcg = 20261005.0; g = 0.0; w = 0.0; rosa = 0.0; k = 0;
b0 = 0.0; b1 = 0.0; b2 = 0.0; b3 = 0.0; b4 = 0.0; b5 = 0.0; b6 = 0.0;"
            input_terminals = "real theta;real vref;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True;"
            input_terminals_show_labels = "True;True;"
            output_fnc = "/*Begin code section*/
/* PLANO B - camadas da Entrega 02 em C (mesmas operacoes de modelo_camadas.py).
   Flags (init_fnc): CAM_FOLGA, CAM_RES, CAM_RUIDO = 1.0 liga / 0.0 desliga. */
if (primeiro > 0.5) { th_c = theta; }
if (CAM_FOLGA > 0.5) {
    th_min = (theta + FOLGA < th_c) ? theta + FOLGA : th_c;
    th_c = (theta > th_min) ? theta : th_min;
} else {
    th_c = theta;
}
th_out = th_c;
if (th_out < 0.0) th_out = 0.0;
if (th_out > THETA_FS) th_out = THETA_FS;
if (primeiro > 0.5) { th_ant = th_out; primeiro = 0.0; }
movendo = (th_out != th_ant) ? 1.0 : 0.0;
th_ant = th_out;
x = th_out / THETA_FS;
if (CAM_RES > 0.5) {
    x = (floor(x * N_PASSOS + 0.5 - FASE) + FASE) / N_PASSOS;
    if (x > 1.0) x = 1.0;
}

/* R8 - ruido de contato 1/f: LCG -> branco (Irwin-Hall) -> filtro de Kellet */
g = 0.0;
for (k = 0; k < 12; k++) {
    s_lcg = fmod(1664525.0 * s_lcg + 1013904223.0, 4294967296.0);
    g = g + s_lcg / 4294967296.0;
}
w = g - 6.0;
b0 = 0.99886 * b0 + w * 0.0555179;
b1 = 0.99332 * b1 + w * 0.0750759;
b2 = 0.96900 * b2 + w * 0.1538520;
b3 = 0.86650 * b3 + w * 0.3104856;
b4 = 0.55000 * b4 + w * 0.5329522;
b5 = -0.7616 * b5 - w * 0.0168980;
rosa = b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362;
b6 = w * 0.115926;
dRc = K_ENR * rosa;

v_cursor = x * vref;
if (CAM_RUIDO > 0.5 && movendo > 0.5) {
    v_cursor = v_cursor + dRc * I_CURSOR;
}
theta_c = th_out;
/*End code section*/"
            output_terminals = "real v_cursor;real theta_c;real dRc;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;"
            output_terminals_show_labels = "True;True;True;"
        }
        [
            position = 7960, 7840
        ]

        component "core/C function" receptor {
            global_variables = "real THETA_FS;real R_L;"
            init_fnc = "THETA_FS = 3600.0;
R_L = 250.000;"
            input_terminals = "real v_rl;real theta_ref;"
            input_terminals_dimensions = "inherit;inherit"
            input_terminals_feedthrough = "True;True;"
            input_terminals_show_labels = "True;True;"
            output_fnc = "/*Begin code section*/
/* Receptor: le a tensao sobre R_L e converte em corrente e em angulo */
i_mA = 1000.0 * v_rl / R_L;
theta_med = THETA_FS * (i_mA - 4.0) / 16.0;
/* erro da corrente medida contra a reta ideal 4-20 mA, em % do fundo de escala */
erro_FE = 100.0 * (i_mA - (4.0 + 16.0 * theta_ref / THETA_FS)) / 16.0;
/*End code section*/"
            output_terminals = "real i_mA;real theta_med;real erro_FE;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;"
            output_terminals_show_labels = "True;True;True;"
        }
